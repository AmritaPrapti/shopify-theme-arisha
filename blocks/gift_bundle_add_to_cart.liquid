{% comment %}
  Gift Bundle — Add to cart
  Renders the submit button for the enclosing product form (opened by the
  parent "Product card" block). Must live inside a "Product card" block.
{% endcomment %}
{%- assign btn_id = 'gb-cart-' | append: block.id -%}

<div class="gb-cart gb-block" style="--gb-pt: {{ block.settings.padding_top }}px; --gb-pb: {{ block.settings.padding_bottom }}px;{% if block.settings.padding_top_mobile > 0 %} --gb-pt-m: {{ block.settings.padding_top_mobile }}px;{% endif %}{% if block.settings.padding_bottom_mobile > 0 %} --gb-pb-m: {{ block.settings.padding_bottom_mobile }}px;{% endif %}" {{ block.shopify_attributes }}>
  <button
    id="{{ btn_id }}"
    type="submit"
    name="add"
    class="gb-cart__button{% if block.settings.style == 'solid' %} gb-cart__button--solid{% endif %}"
    aria-live="polite"
    data-sold-out-message="true"
  >
    <span>{{ block.settings.label | default: 'Add to cart' }}</span>
    <span class="sold-out-message hidden">{{ 'products.product.sold_out' | t }}</span>
    {%- render 'loading-spinner' -%}
  </button>
</div>

{% schema %}
{
  "name": "Add to cart",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Button label",
      "default": "Gift the Complete Care Bundle"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "outline", "label": "Outline" },
        { "value": "solid", "label": "Solid" }
      ],
      "default": "outline"
    }
    ,
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 60, "step": 2, "unit": "px", "label": "Top spacing", "default": 0 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 60, "step": 2, "unit": "px", "label": "Bottom spacing", "default": 0 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 60, "step": 2, "unit": "px", "label": "Top spacing (mobile)", "info": "0 = same as desktop.", "default": 0 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 60, "step": 2, "unit": "px", "label": "Bottom spacing (mobile)", "info": "0 = same as desktop.", "default": 0 }
  ],
  "presets": [{ "name": "Add to cart", "category": "Gift bundle" }]
}
{% endschema %}
