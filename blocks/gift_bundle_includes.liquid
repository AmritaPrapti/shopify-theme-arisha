{% comment %}
  Gift Bundle — Includes (expand/collapse dropdown)
{% endcomment %}
{%- assign panel_id = 'gb-includes-' | append: block.id -%}

<div class="gb-includes gb-block" style="--gb-pt: {{ block.settings.padding_top }}px; --gb-pb: {{ block.settings.padding_bottom }}px;{% if block.settings.padding_top_mobile > 0 %} --gb-pt-m: {{ block.settings.padding_top_mobile }}px;{% endif %}{% if block.settings.padding_bottom_mobile > 0 %} --gb-pb-m: {{ block.settings.padding_bottom_mobile }}px;{% endif %}" {{ block.shopify_attributes }}>
  <button
    type="button"
    class="gb-includes__toggle"
    aria-expanded="false"
    aria-controls="{{ panel_id }}"
    data-open-label="{{ block.settings.open_label | escape }}"
    data-close-label="{{ block.settings.close_label | escape }}"
  >
    <span class="gb-includes__label">{{ block.settings.open_label }}</span>
    <span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span>
  </button>
  <div class="gb-includes__content" id="{{ panel_id }}">
    {{ block.settings.content }}
  </div>
</div>

<script>
  (function () {
    var root = document.currentScript.previousElementSibling;
    if (!root) return;
    var btn = root.querySelector('.gb-includes__toggle');
    var panel = root.querySelector('.gb-includes__content');
    var label = root.querySelector('.gb-includes__label');
    var caret = root.querySelector('.svg-wrapper');

    // Every card in this section opens and closes together. The grid stretches all
    // cards to the tallest one, so opening a single card would leave the others with
    // a tall empty gap at the bottom.
    var scope = root.closest('[id^="shopify-section-"]') || document;
    var EVENT = 'gb:includes-toggle';

    function apply(open) {
      btn.setAttribute('aria-expanded', String(open));
      panel.classList.toggle('is-open', open);
      caret.style.transform = open ? 'rotate(180deg)' : '';
      label.textContent = open ? btn.dataset.closeLabel : btn.dataset.openLabel;
    }

    // The click only announces the new state; every card (this one included) reacts
    // through the listener below, so they can never drift apart.
    btn.addEventListener('click', function () {
      var next = btn.getAttribute('aria-expanded') !== 'true';
      scope.dispatchEvent(new CustomEvent(EVENT, { detail: { open: next } }));
    });

    scope.addEventListener(EVENT, function (evt) {
      apply(evt.detail.open);
    });
  })();
</script>

{% schema %}
{
  "name": "Includes",
  "settings": [
    {
      "type": "text",
      "id": "open_label",
      "label": "Label (collapsed)",
      "default": "See included items"
    },
    {
      "type": "text",
      "id": "close_label",
      "label": "Label (expanded)",
      "default": "Hide included items"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>8 soups, 6 snacks, 3 teas beautifully packaged.</p>"
    }
    ,
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 60, "step": 2, "unit": "px", "label": "Top spacing", "default": 0 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 60, "step": 2, "unit": "px", "label": "Bottom spacing", "default": 0 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 60, "step": 2, "unit": "px", "label": "Top spacing (mobile)", "info": "0 = same as desktop.", "default": 0 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 60, "step": 2, "unit": "px", "label": "Bottom spacing (mobile)", "info": "0 = same as desktop.", "default": 0 }
  ],
  "presets": [{ "name": "Includes", "category": "Gift bundle" }]
}
{% endschema %}
