{% comment %}
  Gift Bundle — Best for
  A label plus a checkmark list. Enter one item per line.
{% endcomment %}
{%- assign items = block.settings.items | newline_to_br | split: '<br />' -%}

<div class="gb-best-for gb-block" style="--gb-pt: {{ block.settings.padding_top }}px; --gb-pb: {{ block.settings.padding_bottom }}px;{% if block.settings.padding_top_mobile > 0 %} --gb-pt-m: {{ block.settings.padding_top_mobile }}px;{% endif %}{% if block.settings.padding_bottom_mobile > 0 %} --gb-pb-m: {{ block.settings.padding_bottom_mobile }}px;{% endif %}" {{ block.shopify_attributes }}>
  {%- if block.settings.label != blank -%}
    <p class="gb-best-for__label">{{ block.settings.label }}</p>
  {%- endif -%}
  {%- if block.settings.items != blank -%}
    <ul class="gb-best-for__list" role="list">
      {%- for item in items -%}
        {%- assign clean = item | strip -%}
        {%- if clean != blank -%}
          <li class="gb-best-for__item">
            <span class="icon-checkmark">{{ 'icon-checkmark.svg' | inline_asset_content }}</span>
            <span>{{ clean }}</span>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Best for",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Best for"
    },
    {
      "type": "textarea",
      "id": "items",
      "label": "Items",
      "info": "One item per line.",
      "default": "Friends\nCoworkers\nBaby showers"
    }
    ,
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 60, "step": 2, "unit": "px", "label": "Top spacing", "default": 0 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 60, "step": 2, "unit": "px", "label": "Bottom spacing", "default": 0 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 60, "step": 2, "unit": "px", "label": "Top spacing (mobile)", "info": "0 = same as desktop.", "default": 0 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 60, "step": 2, "unit": "px", "label": "Bottom spacing (mobile)", "info": "0 = same as desktop.", "default": 0 }
  ],
  "presets": [{ "name": "Best for", "category": "Gift bundle" }]
}
{% endschema %}
