{% comment %}
  Gift Bundle — Title
  Uses closest.product, which resolves to the parent "Product card" block's
  product setting — so no product picker is needed here. A custom title
  overrides the product title.
{% endcomment %}
{%- liquid
  assign display_title = block.settings.title
  if display_title == blank
    assign display_title = closest.product.title
  endif
-%}

{%- if display_title != blank -%}
  <{{ block.settings.heading_tag }}
    class="gb-title gb-block {{ block.settings.heading_size }}"
    style="--gb-pt: {{ block.settings.padding_top }}px; --gb-pb: {{ block.settings.padding_bottom }}px;{% if block.settings.padding_top_mobile > 0 %} --gb-pt-m: {{ block.settings.padding_top_mobile }}px;{% endif %}{% if block.settings.padding_bottom_mobile > 0 %} --gb-pb-m: {{ block.settings.padding_bottom_mobile }}px;{% endif %}"
    {{ block.shopify_attributes }}
  >
    {{- display_title -}}
  </{{ block.settings.heading_tag }}>
{%- endif -%}

{% schema %}
{
  "name": "Title",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Custom title (optional)",
      "info": "Leave blank to use the card product's title."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag (SEO)",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "p", "label": "Paragraph" }
      ],
      "default": "h3"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Text size",
      "options": [
        { "value": "h4", "label": "Small" },
        { "value": "h3", "label": "Medium" },
        { "value": "h2", "label": "Large" }
      ],
      "default": "h3"
    },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 60, "step": 2, "unit": "px", "label": "Top spacing", "default": 0 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 60, "step": 2, "unit": "px", "label": "Bottom spacing", "default": 0 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 60, "step": 2, "unit": "px", "label": "Top spacing (mobile)", "info": "0 = same as desktop.", "default": 0 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 60, "step": 2, "unit": "px", "label": "Bottom spacing (mobile)", "info": "0 = same as desktop.", "default": 0 }
  ],
  "presets": [{ "name": "Title", "category": "Gift bundle" }]
}
{% endschema %}
