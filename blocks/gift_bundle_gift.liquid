{% comment %}
  Gift Bundle — Gift details (required)

  There is no opt-in checkbox: the recipient details ARE the purchase flow. The
  card's add-to-cart click is intercepted, the panel opens (a modal popup by
  default, or expanded in-card), and the cart request only runs once the fields
  validate. Values are submitted as line item properties on the enclosing
  product form (opened by the parent "Product card" block):
    properties[Send as gift]   = "Yes"
    properties[Recipient first name]
    properties[Recipient last name]
    properties[Recipient email]
    properties[Message]

  The popup is a native <dialog>: it paints in the top layer, so it clears the
  sticky header even though the section wrapper is `isolate` (z-index: 0), while
  its inputs stay inside the <form> and are still collected by FormData.

  The click is intercepted in the capture phase on the form — an ancestor of the
  button — so it always runs before the button's default submit, regardless of
  when product-form.js upgrades the <product-form> element.
{% endcomment %}
{%- liquid
  assign uid = block.id
  assign first_id = 'gb-gift-first-' | append: uid
  assign last_id = 'gb-gift-last-' | append: uid
  assign email_id = 'gb-gift-email-' | append: uid
  assign msg_id = 'gb-gift-msg-' | append: uid
  assign title_id = 'gb-gift-title-' | append: uid
  assign mode = block.settings.display_mode | default: 'popup'
-%}

{%- capture gift_panel_inner -%}
  <button
    type="button"
    class="gb-gift__close"
    data-gb-gift-cancel
    aria-label="{{ block.settings.close_label | default: 'Close' | escape }}"
  >
    {{- 'icon-close.svg' | inline_asset_content -}}
  </button>

  {%- if block.settings.heading != blank -%}
    <h3 class="gb-gift__heading" id="{{ title_id }}">{{ block.settings.heading }}</h3>
  {%- endif -%}
  {%- if block.settings.intro != blank -%}
    <p class="gb-gift__intro">{{ block.settings.intro }}</p>
  {%- endif -%}

  <div class="gb-gift__fields">
    <div class="gb-gift__row">
      <div class="gb-gift__field">
        <label for="{{ first_id }}">{{ block.settings.first_name_label }}</label>
        <input
          type="text"
          id="{{ first_id }}"
          name="properties[Recipient first name]"
          placeholder="{{ block.settings.first_name_placeholder }}"
          autocomplete="off"
          required
          data-gb-gift-first
        >
      </div>

      <div class="gb-gift__field">
        <label for="{{ last_id }}">
          {{ block.settings.last_name_label }}
          {%- unless block.settings.require_last_name -%}
            <span class="gb-gift__optional">{{ block.settings.optional_label }}</span>
          {%- endunless -%}
        </label>
        <input
          type="text"
          id="{{ last_id }}"
          name="properties[Recipient last name]"
          placeholder="{{ block.settings.last_name_placeholder }}"
          autocomplete="off"
          {% if block.settings.require_last_name %}required{% endif %}
          data-gb-gift-last
        >
      </div>
    </div>

    <div class="gb-gift__field">
      <label for="{{ email_id }}">{{ block.settings.email_label }}</label>
      <input
        type="email"
        id="{{ email_id }}"
        name="properties[Recipient email]"
        placeholder="{{ block.settings.email_placeholder }}"
        autocomplete="email"
        required
        data-gb-gift-email
      >
    </div>

    <div class="gb-gift__field">
      <label for="{{ msg_id }}">
        {{ block.settings.message_label }}
        {%- unless block.settings.require_message -%}
          <span class="gb-gift__optional">{{ block.settings.optional_label }}</span>
        {%- endunless -%}
      </label>
      <textarea
        id="{{ msg_id }}"
        name="properties[Message]"
        rows="4"
        maxlength="500"
        placeholder="{{ block.settings.message_placeholder }}"
        {% if block.settings.require_message %}required{% endif %}
        data-gb-gift-message
      ></textarea>
    </div>
  </div>

  <p class="gb-gift__error" data-gb-gift-error role="alert"></p>

  <div class="gb-gift__actions">
    <button type="button" class="button button--full-width" data-gb-gift-confirm>
      {{ block.settings.submit_label }}
    </button>
    <button type="button" class="gb-gift__cancel" data-gb-gift-cancel>
      {{ block.settings.cancel_label }}
    </button>
  </div>
{%- endcapture -%}

<div
  class="gb-gift gb-block gb-gift--{{ mode }}"
  data-gb-gift
  data-mode="{{ mode }}"
  data-require-message="{{ block.settings.require_message }}"
  data-require-last-name="{{ block.settings.require_last_name }}"
  style="--gb-pt: {{ block.settings.padding_top }}px; --gb-pb: {{ block.settings.padding_bottom }}px;{% if block.settings.padding_top_mobile > 0 %} --gb-pt-m: {{ block.settings.padding_top_mobile }}px;{% endif %}{% if block.settings.padding_bottom_mobile > 0 %} --gb-pb-m: {{ block.settings.padding_bottom_mobile }}px;{% endif %}"
  {{ block.shopify_attributes }}
>
  {%- comment -%} Gift details are mandatory, so the flag is always submitted. {%- endcomment -%}
  <input type="hidden" name="properties[Send as gift]" value="Yes">

  {%- comment -%}
    The same gift details again as ORDER-level cart attributes, which become the order's
    note attributes. Klaviyo, Shopify Flow and the order CSV export read note attributes
    far more easily than per-line properties.

    Caveat: a cart has only ONE set of attributes. If a buyer orders two bundles for two
    different people, these hold the LAST gift confirmed. The line item properties above
    stay correct for every gift, so treat those as the source of truth per item.

    Values are copied from the fields when the buyer confirms the popup.
  {%- endcomment -%}
  <input type="hidden" name="attributes[Is gift order]" value="Yes">
  <input type="hidden" name="attributes[Gift recipient first name]" value="" data-gb-gift-attr="first">
  <input type="hidden" name="attributes[Gift recipient last name]" value="" data-gb-gift-attr="last">
  <input type="hidden" name="attributes[Gift recipient email]" value="" data-gb-gift-attr="email">
  <input type="hidden" name="attributes[Gift message]" value="" data-gb-gift-attr="message">

  {%- if mode == 'inline' -%}
    <div
      class="gb-gift__panel"
      data-gb-gift-panel
      role="group"
      tabindex="-1"
      {% if block.settings.heading != blank %}aria-labelledby="{{ title_id }}"{% endif %}
      hidden
    >
      {{ gift_panel_inner }}
    </div>
  {%- else -%}
    <dialog
      class="gb-gift__panel"
      data-gb-gift-panel
      tabindex="-1"
      {% if block.settings.heading != blank %}aria-labelledby="{{ title_id }}"{% endif %}
    >
      {{ gift_panel_inner }}
    </dialog>
  {%- endif -%}
</div>

<script>
  (function () {
    var root = document.currentScript.previousElementSibling;
    while (root && !(root.hasAttribute && root.hasAttribute('data-gb-gift'))) {
      root = root.previousElementSibling;
    }
    if (!root) return;

    var panel = root.querySelector('[data-gb-gift-panel]');
    var first = root.querySelector('[data-gb-gift-first]');
    var last = root.querySelector('[data-gb-gift-last]');
    var email = root.querySelector('[data-gb-gift-email]');
    var message = root.querySelector('[data-gb-gift-message]');
    var error = root.querySelector('[data-gb-gift-error]');
    var confirmButton = root.querySelector('[data-gb-gift-confirm]');
    var requireMessage = root.getAttribute('data-require-message') === 'true';
    var requireLastName = root.getAttribute('data-require-last-name') === 'true';
    var contactError = {{ block.settings.contact_error_text | json }};
    var invalidEmailError = {{ block.settings.invalid_email_error_text | json }};
    var messageError = {{ block.settings.message_error_text | json }};
    var form = root.closest('form');
    if (!form || !panel) return;

    var mode = root.getAttribute('data-mode');
    if (mode !== 'inline' && typeof panel.showModal !== 'function') mode = 'inline';

    // One-shot: set only for the submit dispatched by the confirm button, so
    // every other route to the cart has to go through the panel first.
    var confirmed = false;
    var opener = null;

    function isOpen() {
      return mode === 'inline' ? !panel.hidden : panel.open;
    }

    function open(triggerEl) {
      if (isOpen()) return;
      opener = triggerEl || null;
      if (mode === 'inline') {
        panel.hidden = false;
        panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } else {
        panel.showModal();
      }
      // Focus the panel, not the first field: showModal() would otherwise land on
      // the close button, and focusing the email input pops the browser's autofill
      // list over the form. Tab from here still reaches the fields in order.
      panel.focus({ preventScroll: true });
    }

    function close() {
      if (!isOpen()) return;
      hideError();
      if (mode === 'inline') {
        panel.hidden = true;
      } else {
        panel.close();
      }
      if (opener && document.contains(opener)) opener.focus();
      opener = null;
    }

    function showError(msg, focusEl) {
      error.textContent = msg;
      error.classList.add('is-visible');
      if (focusEl) focusEl.focus();
    }

    function hideError() {
      error.classList.remove('is-visible');
      error.textContent = '';
    }

    // Checked in the same order the fields are shown, so the message always points
    // at the topmost problem.
    function firstInvalidField() {
      if (first.value.trim() === '') {
        return { field: first, message: contactError };
      }
      if (requireLastName && last.value.trim() === '') {
        return { field: last, message: contactError };
      }
      // An empty email is part of "we still need your details"; a typed-but-broken one
      // needs to say what is actually wrong with it.
      if (email.value.trim() === '') {
        return { field: email, message: contactError };
      }
      if (!email.checkValidity()) {
        return { field: email, message: invalidEmailError };
      }
      if (requireMessage && message.value.trim() === '') {
        return { field: message, message: messageError };
      }
      return null;
    }

    [first, last, email, message].forEach(function (el) {
      el.addEventListener('input', hideError);
    });

    // ---- Order-level cart attributes -------------------------------------------
    // The hidden attributes[...] inputs are submitted with the add-to-cart request,
    // but cart attributes are not part of the documented /cart/add payload, so they
    // are also written explicitly with /cart/update.js once the item is in the cart.
    var attrPairs = [
      [first, root.querySelector('[data-gb-gift-attr="first"]')],
      [last, root.querySelector('[data-gb-gift-attr="last"]')],
      [email, root.querySelector('[data-gb-gift-attr="email"]')],
      [message, root.querySelector('[data-gb-gift-attr="message"]')],
    ];

    function syncAttributes() {
      attrPairs.forEach(function (pair) {
        if (pair[1]) pair[1].value = pair[0].value.trim();
      });
    }

    // Reads every attributes[...] input in the form, so the bundle name and URL added
    // by the parent "Product card" block are included without naming them again here.
    function pushAttributes() {
      var payload = {};
      form.querySelectorAll('input[name^="attributes["]').forEach(function (input) {
        var key = input.name.slice(11, -1);
        if (key) payload[key] = input.value;
      });
      var url = (window.routes && window.routes.cart_update_url) || '/cart/update';
      fetch(url + '.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ attributes: payload }),
      })
        .then(function (response) {
          if (!response.ok) throw new Error('cart/update.js responded ' + response.status);
          return response.json();
        })
        .then(function (cart) {
          console.log('[gift] cart attributes saved', cart.attributes);
        })
        .catch(function (e) {
          // The add itself already succeeded, so this must not break the cart — but it
          // has to be visible, or a silent failure looks like "the data is not saving".
          console.warn('[gift] could not save cart attributes', payload, e);
        });
    }

    confirmButton.addEventListener('click', function () {
      var invalid = firstInvalidField();
      if (invalid) {
        showError(invalid.message, invalid.field);
        return;
      }
      hideError();
      syncAttributes();
      close();
      confirmed = true;
      // Synchronous: product-form.js reads the form on this event, and the flag
      // is cleared again before anything else can submit.
      if (typeof form.requestSubmit === 'function') {
        form.requestSubmit();
      } else {
        form.submit();
      }
      confirmed = false;
    });

    root.querySelectorAll('[data-gb-gift-cancel]').forEach(function (el) {
      el.addEventListener('click', close);
    });

    panel.addEventListener('keydown', function (evt) {
      // The fields belong to the product form, so Enter would otherwise trigger
      // its implicit submission instead of confirming the gift details. Only the
      // single-line input opts in — Enter is a newline in the textarea, and on the
      // panel itself (where focus starts) it should do nothing.
      if (evt.key === 'Enter' && evt.target.tagName === 'INPUT') {
        evt.preventDefault();
        confirmButton.click();
        return;
      }
      // <dialog> handles Escape itself; the in-card panel does not.
      if (evt.key === 'Escape' && mode === 'inline') {
        evt.preventDefault();
        close();
      }
    });

    if (mode !== 'inline') {
      // A click on ::backdrop targets the dialog itself.
      panel.addEventListener('click', function (evt) {
        if (evt.target === panel) close();
      });
      // Esc closes natively; keep the error state in sync.
      panel.addEventListener('close', hideError);
    }

    // Intercept the add-to-cart button on the way down to it.
    form.addEventListener(
      'click',
      function (evt) {
        if (confirmed) return;
        var button = evt.target.closest('button[type="submit"], input[type="submit"]');
        if (!button || !form.contains(button)) return;
        evt.preventDefault();
        evt.stopPropagation();
        open(button);
      },
      true
    );

    // Belt and braces for a submit raised by anything other than that click.
    form.addEventListener(
      'submit',
      function (evt) {
        if (confirmed) return;
        evt.preventDefault();
        evt.stopImmediatePropagation();
        open(form.querySelector('button[type="submit"]'));
      },
      true
    );

    function onReady(fn) {
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', fn, { once: true });
      } else {
        fn();
      }
    }

    // Clear the recipient after a successful add so the next gift starts blank.
    onReady(function () {
      if (typeof subscribe !== 'function' || typeof PUB_SUB_EVENTS === 'undefined') return;
      subscribe(PUB_SUB_EVENTS.cartUpdate, function (event) {
        var variantInput = form.querySelector('[name="id"]');
        if (event.source !== 'product-form' || !variantInput) return;
        if (String(event.productVariantId) !== String(variantInput.value)) return;
        // Write the attributes before clearing — pushAttributes() builds its payload
        // synchronously, so clearing straight after is safe.
        pushAttributes();
        [first, last, email, message].forEach(function (el) {
          el.value = '';
        });
        hideError();
      });
    });

    // Let merchants see the panel while the block is selected in the editor.
    document.addEventListener('shopify:block:select', function (evt) {
      if (root.contains(evt.target) || evt.target === root) open(null);
    });
    document.addEventListener('shopify:block:deselect', function (evt) {
      if (root.contains(evt.target) || evt.target === root) close();
    });
  })();
</script>

{% schema %}
{
  "name": "Gift details",
  "settings": [
    {
      "type": "paragraph",
      "content": "Recipient details are asked for when the buyer clicks the add-to-cart button, and must be filled in before the item can be added."
    },
    {
      "type": "select",
      "id": "display_mode",
      "label": "How to ask",
      "options": [
        { "value": "popup", "label": "Popup over the page" },
        { "value": "inline", "label": "Expand inside the card" }
      ],
      "default": "popup"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Who is this gift for?"
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Description",
      "default": "We'll email your gift note to them with the order."
    },
    {
      "type": "text",
      "id": "first_name_label",
      "label": "First name label",
      "default": "Recipient first name"
    },
    {
      "type": "text",
      "id": "first_name_placeholder",
      "label": "First name placeholder",
      "default": "First name"
    },
    {
      "type": "text",
      "id": "last_name_label",
      "label": "Last name label",
      "default": "Recipient last name"
    },
    {
      "type": "text",
      "id": "last_name_placeholder",
      "label": "Last name placeholder",
      "default": "Last name"
    },
    {
      "type": "checkbox",
      "id": "require_last_name",
      "label": "Require last name",
      "info": "The first name is always required. When off, the last name is optional.",
      "default": false
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Recipient email"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "name@example.com"
    },
    {
      "type": "text",
      "id": "message_label",
      "label": "Message label",
      "default": "Gift message"
    },
    {
      "type": "text",
      "id": "message_placeholder",
      "label": "Message placeholder",
      "default": "Write a short note…"
    },
    {
      "type": "checkbox",
      "id": "require_message",
      "label": "Require a message",
      "info": "When off, the message is optional and only the recipient email is required.",
      "default": false
    },
    {
      "type": "text",
      "id": "optional_label",
      "label": "\"Optional\" tag",
      "info": "Shown next to the message label when a message isn't required.",
      "default": "Optional"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Confirm button",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "cancel_label",
      "label": "Cancel button",
      "default": "Cancel"
    },
    {
      "type": "text",
      "id": "close_label",
      "label": "Close button label",
      "info": "Accessibility label for the popup's ✕ button.",
      "default": "Close"
    },
    {
      "type": "header",
      "content": "Validation messages"
    },
    {
      "type": "text",
      "id": "contact_error_text",
      "label": "Missing name or email",
      "default": "Please add recipient's name and email address to continue."
    },
    {
      "type": "text",
      "id": "invalid_email_error_text",
      "label": "Invalid email",
      "info": "Shown when an email is typed but is not a valid address.",
      "default": "Please add a valid email address to continue."
    },
    {
      "type": "text",
      "id": "message_error_text",
      "label": "Missing message",
      "default": "Please add a gift message to continue."
    },
    { "type": "header", "content": "Spacing" },
    {
      "type": "paragraph",
      "content": "Spacing applies to the in-card layout only."
    },
    { "type": "range", "id": "padding_top", "min": 0, "max": 60, "step": 2, "unit": "px", "label": "Top spacing", "default": 0 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 60, "step": 2, "unit": "px", "label": "Bottom spacing", "default": 0 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 60, "step": 2, "unit": "px", "label": "Top spacing (mobile)", "info": "0 = same as desktop.", "default": 0 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 60, "step": 2, "unit": "px", "label": "Bottom spacing (mobile)", "info": "0 = same as desktop.", "default": 0 }
  ],
  "presets": [{ "name": "Gift details", "category": "Gift bundle" }]
}
{% endschema %}
