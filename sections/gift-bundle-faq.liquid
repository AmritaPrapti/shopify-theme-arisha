{% comment %}
  Gift Bundle FAQ
  ---------------
  Two-column section built from nested theme blocks:

    section (this file)
      ├─ gift_faq_accordion   (left)  → nested gift_faq_item (question + answer)
      └─ gift_feature_panel   (right) → image (setting) + nested:
                                                gift_feature_text   (title + description)
                                                gift_feature_button

  Each panel renders its own children with a nested blocks content tag.
{% endcomment %}

{%- style -%}
  html {
    scroll-behavior: smooth;
    scroll-padding-top: var(--header-height, 6rem);
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} {
    --gbf-muted: rgba(var(--color-foreground), 0.6);
    --gbf-border: rgba(var(--color-foreground), 0.14);
  }

  .gb-faq-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.2rem;
    align-items: start;
  }
  @media screen and (min-width: 990px) {
    .gb-faq-layout {
      grid-template-columns: {{ section.settings.faq_column_width }}fr {{ 100 | minus: section.settings.faq_column_width }}fr;
      gap: 4rem;
    }
  }

  /* ---- FAQ accordion (left) ---- */
  .gb-faq__eyebrow {
    color: var(--gbf-muted);
    margin: 0 0 1rem;
  }
  .gb-faq__heading {
    margin: 0 0 2.4rem;
  }
  .gb-faq__list {
    display: grid;
  }
  .gb-faq__item {
    border-bottom: 1px solid var(--gbf-item-border, var(--gbf-border));
    background-color: var(--gbf-item-bg, transparent);
    overflow: hidden;
  }
  .gb-faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
    padding: 1.4rem 0;
    cursor: pointer;
    font-weight: 500;
    list-style: none;
    color: var(--gbf-q, inherit);
  }
  .gb-faq__q::-webkit-details-marker { display: none; }
  .gb-faq__caret {
    display: inline-flex;
    flex-shrink: 0;
    width: 1.4rem;
    height: 1.4rem;
    transition: transform 0.2s ease;
    color: var(--gbf-muted);
  }
  .gb-faq__item[open] .gb-faq__caret { transform: rotate(180deg); }
  .gb-faq__a {
    padding: 0 0 1.6rem;
    font-size: 1.4rem;
    color: var(--gbf-a, var(--gbf-muted));
  }
  .gb-faq__a > :first-child { margin-top: 0; }
  .gb-faq__a > :last-child { margin-bottom: 0; }

  /* ---- Feature panel (right): image column + content column ---- */
  .gb-feature {
    position: relative;
    border-radius: var(--gbf-feature-radius, 0);
    overflow: hidden;
    background-color: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    display: grid;
    grid-template-columns: 1fr;
  }
  @media screen and (min-width: 750px) {
    .gb-feature {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
    }
    .gb-feature--image-right .gb-feature__media { order: 2; }
  }
  .gb-feature__media {
    position: relative;
    min-height: 22rem;
  }
  .gb-feature__media img,
  .gb-feature__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Image size options */
  .gb-feature--img-small .gb-feature__media { min-height: 20rem; }
  .gb-feature--img-medium .gb-feature__media { min-height: 30rem; }
  .gb-feature--img-large .gb-feature__media { min-height: 42rem; }
  .gb-feature--img-adapt .gb-feature__media { min-height: 0; }
  .gb-feature--img-adapt .gb-feature__media img {
    height: auto;
    object-fit: contain;
  }
  .gb-feature__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2.4rem, 4vw, 4rem);
    gap: 0;
  }

  @media screen and (max-width: 750px) {
    .gb-feature__content {
      text-align: center;
    }
  }

  .gb-feature-title {
    margin: 0 0 1.4rem;
    line-height: 1.15;
  }
  .gb-feature-body {
    margin: 0;
    font-size: 1.5rem;
    opacity: 0.85;
  }
  .gb-feature-body > :first-child { margin-top: 0; }
  .gb-feature-body > :last-child { margin-bottom: 0; }

  .gb-feature__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 2rem;
    padding: 1.3rem 2.2rem;
    border-radius: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 1.3rem;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }
  .gb-feature__btn:hover { opacity: 0.88; }
  .gb-feature__btn .svg-wrapper { display: inline-flex; width: 1.6rem; height: 1.6rem; }
{%- endstyle -%}

<script>
  (function () {
    if (window.__gbSmoothAnchors) return;
    window.__gbSmoothAnchors = true;
    document.addEventListener('click', function (evt) {
      var link = evt.target.closest('a[href^="#"]');
      if (!link) return;
      var id = link.getAttribute('href').slice(1);
      if (!id) return;
      var target = document.getElementById(id);
      if (!target) return;
      evt.preventDefault();
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  })();
</script>

<div {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id | handle }}"{% endif %} class="color-{{ section.settings.color_scheme }} isolate gradient">
  <div class="section-{{ section.id }}-padding page-width">
    <div class="gb-faq-layout">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Gift Bundle FAQ",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Link to this section from a button with #your-id (letters, numbers and hyphens)."
    },
    {
      "type": "range",
      "id": "faq_column_width",
      "min": 30,
      "max": 60,
      "step": 5,
      "unit": "%",
      "label": "FAQ column width (desktop)",
      "default": 45
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 52
    }
  ],
  "blocks": [
    { "type": "gift_faq_accordion" },
    { "type": "gift_feature_panel" }
  ],
  "presets": [
    {
      "name": "Gift Bundle FAQ"
    }
  ]
}
{% endschema %}
