{% comment %}
  Gift Bundle Blocks
  -------------------
  A section that renders "gift bundle" product cards using NESTED theme blocks.

  Structure:
    section (this file)
      └─ gift_bundle_product   (parent block — owns the product + <form>)
           ├─ gift_bundle_title
           ├─ gift_bundle_subtitle
           ├─ gift_bundle_best_for
           ├─ gift_bundle_stats
           ├─ gift_bundle_includes
           ├─ gift_bundle_price
           ├─ gift_bundle_add_to_cart
           └─ gift_bundle_gift   (send-as-a-gift → line item properties)

  Child blocks are isolated (they cannot read the parent's product), so the
  parent product block opens the product <form> and renders its children with
  {% content_for 'blocks' %} INSIDE that form. The add-to-cart button and the
  gift property inputs are therefore collected by the enclosing form via DOM
  ancestry — no product variable is needed inside the children.
{% endcomment %}

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

<script>
  /* Smooth-scroll same-page anchor links without writing "#id" into the URL. */
  (function () {
    if (window.__gbSmoothAnchors) return;
    window.__gbSmoothAnchors = true;
    document.addEventListener('click', function (evt) {
      var link = evt.target.closest('a[href^="#"]');
      if (!link) return;
      var id = link.getAttribute('href').slice(1);
      if (!id) return;
      var target = document.getElementById(id);
      if (!target) return;
      evt.preventDefault();
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  })();
</script>

{%- style -%}
  /* Smooth anchor scrolling + offset so targets clear the sticky header. */
  html {
    scroll-behavior: smooth;
    scroll-padding-top: var(--header-height, 6rem);
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} {
    --gb-accent: {{ section.settings.accent_color }};
    --gb-accent-text: {{ section.settings.accent_text_color }};
    --gb-card-bg: {{ section.settings.card_bg_color }};
    --gb-card-border: {{ section.settings.card_border_color }};
    --gb-check: {{ section.settings.check_color }};
    --gb-muted: {{ section.settings.muted_text_color }};
  }

  .gift-bundle__header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .gift-bundle__eyebrow {
    color: var(--gb-muted);
    margin: 0 0 1.2rem;
  }

  .gift-bundle__heading {
    /* Auto side margins keep it centred inside the centred header. */
    margin: 0 auto;
    max-width: var(--gb-heading-max, 88rem);
  }

  .gift-bundle-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
    gap: 2.4rem;
    align-items: stretch;
  }

  @media screen and (min-width: 990px) {
    .gift-bundle-grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    }
  }

  /* ---- Card (parent product block) ---- */
  .gift-bundle-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background-color: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    border: 1px solid rgba(var(--color-foreground), 0.08);
    border-radius: var(--gb-radius, 1.6rem);
    padding: 3.2rem 2.8rem;
    height: 100%;
  }

  .gift-bundle-card--highlight {
    border-color: var(--gb-highlight, var(--gb-accent));
    box-shadow: 0 1.2rem 3.2rem rgba(var(--color-shadow, 0, 0, 0), 0.12);
  }

  .gift-bundle-card__badge {
    position: absolute;
    top: 2rem;
    right: 2rem;
    background: var(--gb-accent);
    color: var(--gb-accent-text);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 0.5rem 1.2rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .gift-bundle-card__form {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    gap: var(--gb-gap, 1.4rem);
  }

  /* Push the price (and everything after it — gift / cart) to the bottom so
     cards of differing content length still align their action area. */
  .gift-bundle-card__form > .gb-price {
    margin-top: auto;
  }

  /* Per-block padding (with optional mobile override). */
  .gb-block {
    padding-top: var(--gb-pt, 0px);
    padding-bottom: var(--gb-pb, 0px);
  }
  @media screen and (max-width: 749px) {
    .gb-block {
      padding-top: var(--gb-pt-m, var(--gb-pt, 0px));
      padding-bottom: var(--gb-pb-m, var(--gb-pb, 0px));
    }
  }

  /* ---- Title ---- */
  .gb-title {
    margin: 0;
    line-height: 1.1;
    padding-right: 7rem;
  }

  /* ---- Subtitle ---- */
  .gb-subtitle {
    text-transform: uppercase;
   
    font-size: 14px;
    font-weight: 600;
    color: var(--gb-muted);
    margin: -0.6rem 0 0;
  }
  .gb-subtitle--accent {
    color: var(--gb-accent);
  }

  /* ---- Best for ---- */
  .gb-best-for__label, .gb-includes__label {
    font-weight: 600;
    margin: 0 0 0.8rem;
    font-size: 16px;
    text-transform: uppercase;
  }

  .gb-includes__label{
    margin: 0;
  }
  .gb-best-for__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .gb-best-for__item {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-size: 1.4rem;
  }
  .gb-best-for__item .icon-checkmark {
    width: 1.3rem;
    height: 1.3rem;
    flex-shrink: 0;
    color: var(--gb-check);
    display: inline-flex;
  }

  /* ---- Stats (soup / snack / teas) ---- */
  .gb-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    text-align: center;
  }
  .gb-stat__icon {
    height: 3.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--gb-accent);
  }
  .gb-stat__icon img,
  .gb-stat__icon svg {
    max-height: 3.2rem;
    width: auto;
  }
  .gb-stat__num {
    font-size: 3.2rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--gb-highlight, var(--gb-accent));
  }
  /* Outlined (hollow) numbers — chosen per Stats block in the theme editor.
     Guarded so browsers without text-stroke keep readable filled numbers
     instead of transparent ones. */
  @supports (-webkit-text-stroke: 1px red) {
    .gb-stats--outlined .gb-stat__num {
      color: transparent;
      -webkit-text-stroke: var(--gb-stat-stroke, 1.5px) var(--gb-highlight, var(--gb-accent));
    }
  }
  .gb-stat__label {
    font-size: 1.3rem;
    color: var(--gb-muted);
    font-weight: 600;
  }

  /* ---- Includes (dropdown) ---- */
  .gb-includes__toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    background: none;
    border: none;
    padding: 1rem 0;
    cursor: pointer;
    font: inherit;
    font-weight: 600;
    color: inherit;
    border-top: 1px solid rgba(var(--color-foreground), 0.12);
    padding-bottom: 0rem;
  }
  .gb-includes__toggle .svg-wrapper {
    display: inline-flex;
    transition: transform 0.2s ease;
    width: 1.6rem;
    height: 1.6rem;
  }
  .gb-includes__content {
    display: none;
    padding-bottom: 0.8rem;
    font-size: 1.4rem;
  }
  .gb-includes__content.is-open {
    display: block;
  }

  /* ---- Price ---- */
  .gb-price {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .gb-price__current {
    font-size: 2.4rem;
    font-weight: 600;
  }
  .gb-price__compare {
    text-decoration: line-through;
    color: var(--gb-muted);
    font-size: 1.6rem;
  }
  .gb-price__save {
    background: var(--gb-accent);
    color: var(--gb-accent-text);
    font-size: 1.1rem;
    font-weight: 600;
    padding: 0.4rem 1rem;
    border-radius: 999px;
  }




  /* ---- Gift details (opens from the add-to-cart button) ---- */

  /* Popup mode has no in-card box of its own — the panel paints in the top
     layer — so the block must not add a gap to the card's flex column. */
  .gb-gift--popup {
    display: contents;
  }

  .gb-gift__panel {
    background-color: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    text-align: left;
  }

  dialog.gb-gift__panel {
    position: fixed;
    inset: 0;
    z-index: 1000;
    width: min(46rem, calc(100vw - 4rem));
    max-height: calc(100vh - 4rem);
    margin: auto;
    overflow-y: auto;
    padding: 3.2rem 2.8rem;
    border: 1px solid rgba(var(--color-foreground), 0.1);
    border-radius: var(--gb-radius, 1.6rem);
    box-shadow: 0 2rem 5rem rgba(0, 0, 0, 0.25);
  }
  dialog.gb-gift__panel::backdrop {
    background-color: rgba(0, 0, 0, 0.55);
  }
  dialog.gb-gift__panel[open] {
    animation: gb-gift-panel-in 0.18s ease-out;
  }
  @keyframes gb-gift-panel-in {
    from {
      opacity: 0;
      transform: translateY(0.8rem);
    }
  }

  .gb-gift--inline .gb-gift__panel {
    padding-top: 1.6rem;
    border-top: 1px solid rgba(var(--color-foreground), 0.12);
  }
  .gb-gift--inline .gb-gift__close {
    display: none;
  }

  .gb-gift__heading {
    margin: 0 0 0.4rem;
    font-size: 2.4rem;
    font-weight: 600;
    padding-right: 3rem;
  }
  .gb-gift__intro {
    margin: 0 0 1.8rem;
    font-size: 1.4rem;
    color: var(--gb-muted);
  }
  .gb-gift__close {
    position: absolute;
    top: 1.4rem;
    right: 1.4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.2rem;
    height: 3.2rem;
    padding: 0.8rem;
    background: none;
    border: none;
    color: inherit;
    cursor: pointer;
  }
  .gb-gift__close svg {
    width: 100%;
    height: 100%;
  }
  .gb-gift__fields {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }
  /* First / last name side by side, collapsing to one column when too narrow. */
  .gb-gift__row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.2rem;
  }
  .gb-gift__optional {
    font-weight: 400;
    color: var(--gb-muted);
  }
  .gb-gift__actions {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-top: 1.8rem;
  }
  .gb-gift__cancel {
    padding: 0.8rem;
    background: none;
    border: none;
    font: inherit;
    font-size: 1.3rem;
    color: var(--gb-muted);
    text-decoration: underline;
    cursor: pointer;
  }
  .gb-gift__field label {
    display: block;
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 0.4rem;
  }
  .gb-gift__field input,
  .gb-gift__field textarea {
    width: 100%;
    padding: 1rem 1.2rem;
    border: 1px solid rgba(var(--color-foreground), 0.2);
    border-radius: 0.6rem;
    font: inherit;
    background-color: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  /* The theme's global focus ring is a thick offset outline — too heavy for a
     field sitting in a small panel. Hug the field instead. */
  .gb-gift__field input:focus,
  .gb-gift__field input:focus-visible,
  .gb-gift__field textarea:focus,
  .gb-gift__field textarea:focus-visible {
    outline: none;
    border-color: rgba(var(--color-foreground), 0.75);
    box-shadow: 0 0 0 0.2rem rgba(var(--color-foreground), 0.08);
  }
  /* Focus lands on the panel when it opens; don't ring the whole box. */
  .gb-gift__panel:focus,
  .gb-gift__panel:focus-visible {
    outline: none;
  }
  .gb-gift__field textarea {
    resize: vertical;
    min-height: 8rem;
  }
  .gb-gift__error {
    color: var(--gb-accent);
    font-size: 1.3rem;
    margin: 1.2rem 0 0;
    display: none;
  }
  .gb-gift__error.is-visible {
    display: block;
  }

  .gb-includes__content h5, .gb-includes__content h6, .gb-includes__content h4, .gb-includes__content h3, .gb-includes__content h2, .gb-includes__content h1 {
    margin: 10px 0;
    font-weight: 600;
  }
{%- endstyle -%}

<div {% if section.settings.anchor_id != blank %}id="{{ section.settings.anchor_id | handle }}"{% endif %} class="color-{{ section.settings.color_scheme }} isolate gradient">
  <div class="section-{{ section.id }}-padding page-width">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="gift-bundle__header">
        {%- if section.settings.eyebrow != blank -%}
          <p
            class="gift-bundle__eyebrow {{ section.settings.eyebrow_style }}--{{ section.settings.eyebrow_size }} {{ section.settings.eyebrow_style }}"
            style="{% if section.settings.eyebrow_color != blank %}color: {{ section.settings.eyebrow_color }};{% endif %} --caption-highlight: {{ section.settings.eyebrow_highlight }}; font-weight: {{ section.settings.eyebrow_weight }};"
          >{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="gift-bundle__heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="gift-bundle-grid">
      {% content_for 'blocks' %}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Gift Bundle Blocks",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "gift-bundle",
      "info": "Link to this section from a button with #your-id (letters, numbers and hyphens)."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Caption",
      "default": "Choose the perfect gift",
      "info": "Supports <span> tags for highlighting specific words."
    },
    {
      "type": "select",
      "id": "eyebrow_style",
      "label": "Caption text style",
      "options": [
        { "value": "subtitle", "label": "Subtitle" },
        { "value": "caption-with-letter-spacing", "label": "Caption" }
      ],
      "default": "caption-with-letter-spacing"
    },
    {
      "type": "select",
      "id": "eyebrow_size",
      "label": "Caption size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "eyebrow_weight",
      "label": "Caption font weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi bold" }
      ],
      "default": "500"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Caption color"
    },
    {
      "type": "color",
      "id": "eyebrow_highlight",
      "label": "Caption highlight color",
      "info": "Used for any text wrapped in a <span> within the eyebrow."
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Find the right gift for her"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#b23a48"
    },
    {
      "type": "color",
      "id": "accent_text_color",
      "label": "Accent text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card background",
      "default": "#fdf3f2"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border",
      "default": "#f0dcda"
    },
    {
      "type": "color",
      "id": "check_color",
      "label": "Checkmark color",
      "default": "#cc858f"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Muted text",
      "default": "#8a7a78"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 52
    }
  ],
  "blocks": [
    { "type": "_text" },
    { "type": "gift_bundle_product" }
  ],
  "presets": [
    {
      "name": "Gift Bundle Blocks"
    }
  ]
}
{% endschema %}
