{% comment %}
  Gift Bundle Blocks
  -------------------
  A section that renders "gift bundle" product cards using NESTED theme blocks.

  Structure:
    section (this file)
      └─ gift_bundle_product   (parent block — owns the product + <form>)
           ├─ gift_bundle_title
           ├─ gift_bundle_subtitle
           ├─ gift_bundle_best_for
           ├─ gift_bundle_stats
           ├─ gift_bundle_includes
           ├─ gift_bundle_price
           ├─ gift_bundle_add_to_cart
           └─ gift_bundle_gift   (send-as-a-gift → line item properties)

  Child blocks are isolated (they cannot read the parent's product), so the
  parent product block opens the product <form> and renders its children with
  {% content_for 'blocks' %} INSIDE that form. The add-to-cart button and the
  gift property inputs are therefore collected by the enclosing form via DOM
  ancestry — no product variable is needed inside the children.
{% endcomment %}

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #shopify-section-{{ section.id }} {
    --gb-accent: {{ section.settings.accent_color }};
    --gb-accent-text: {{ section.settings.accent_text_color }};
    --gb-card-bg: {{ section.settings.card_bg_color }};
    --gb-card-border: {{ section.settings.card_border_color }};
    --gb-check: {{ section.settings.check_color }};
    --gb-muted: {{ section.settings.muted_text_color }};
  }

  .gift-bundle__header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .gift-bundle__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.25em;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--gb-muted);
    margin: 0 0 1.2rem;
  }

  .gift-bundle__heading {
    margin: 0;
  }

  .gift-bundle-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
    gap: 2.4rem;
    align-items: stretch;
  }

  @media screen and (min-width: 990px) {
    .gift-bundle-grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    }
  }

  /* ---- Card (parent product block) ---- */
  .gift-bundle-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background-color: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    border: 1px solid rgba(var(--color-foreground), 0.08);
    border-radius: var(--gb-radius, 1.6rem);
    padding: 3.2rem 2.8rem;
    height: 100%;
  }

  .gift-bundle-card--highlight {
    border-color: var(--gb-highlight, var(--gb-accent));
    box-shadow: 0 1.2rem 3.2rem rgba(var(--color-shadow, 0, 0, 0), 0.12);
  }

  .gift-bundle-card__badge {
    position: absolute;
    top: 2rem;
    right: 2rem;
    background: var(--gb-accent);
    color: var(--gb-accent-text);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 0.5rem 1.2rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .gift-bundle-card__form {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    gap: var(--gb-gap, 1.4rem);
  }

  /* Push the price (and everything after it — gift / cart) to the bottom so
     cards of differing content length still align their action area. */
  .gift-bundle-card__form > .gb-price {
    margin-top: auto;
  }

  /* Per-block padding (with optional mobile override). */
  .gb-block {
    padding-top: var(--gb-pt, 0px);
    padding-bottom: var(--gb-pb, 0px);
  }
  @media screen and (max-width: 749px) {
    .gb-block {
      padding-top: var(--gb-pt-m, var(--gb-pt, 0px));
      padding-bottom: var(--gb-pb-m, var(--gb-pb, 0px));
    }
  }

  /* ---- Title ---- */
  .gb-title {
    margin: 0;
    line-height: 1.1;
  }

  /* ---- Subtitle ---- */
  .gb-subtitle {
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--gb-muted);
    margin: -0.6rem 0 0;
  }
  .gb-subtitle--accent {
    color: var(--gb-accent);
  }

  /* ---- Best for ---- */
  .gb-best-for__label {
    font-weight: 700;
    margin: 0 0 0.8rem;
    font-size: 1.5rem;
  }
  .gb-best-for__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .gb-best-for__item {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-size: 1.4rem;
  }
  .gb-best-for__item .icon-checkmark {
    width: 1.3rem;
    height: 1.3rem;
    flex-shrink: 0;
    color: var(--gb-check);
  }

  /* ---- Stats (soup / snack / teas) ---- */
  .gb-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    text-align: center;
  }
  .gb-stat__icon {
    height: 3.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--gb-accent);
  }
  .gb-stat__icon img,
  .gb-stat__icon svg {
    max-height: 3.2rem;
    width: auto;
  }
  .gb-stat__num {
    font-size: 2.4rem;
    font-weight: 500;
    color: var(--gb-highlight, var(--gb-accent));
    line-height: 1.2;
  }
  .gb-stat__label {
    font-size: 1.3rem;
    color: var(--gb-muted);
  }

  /* ---- Includes (dropdown) ---- */
  .gb-includes__toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    background: none;
    border: none;
    padding: 1rem 0;
    cursor: pointer;
    font: inherit;
    font-weight: 600;
    color: inherit;
    border-top: 1px solid rgba(var(--color-foreground), 0.12);
  }
  .gb-includes__toggle .svg-wrapper {
    display: inline-flex;
    transition: transform 0.2s ease;
  }
  .gb-includes__content {
    display: none;
    padding-bottom: 0.8rem;
    font-size: 1.4rem;
  }
  .gb-includes__content.is-open {
    display: block;
  }

  /* ---- Price ---- */
  .gb-price {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .gb-price__current {
    font-size: 2.2rem;
    font-weight: 700;
  }
  .gb-price__compare {
    text-decoration: line-through;
    color: var(--gb-muted);
    font-size: 1.6rem;
  }
  .gb-price__save {
    background: var(--gb-accent);
    color: var(--gb-accent-text);
    font-size: 1.1rem;
    font-weight: 600;
    padding: 0.4rem 1rem;
    border-radius: 999px;
  }

  /* ---- Add to cart ---- */
  .gb-cart__button {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    padding: 1.3rem 1.6rem;
    border-radius: 0.8rem;
    border: 1px solid var(--gb-accent);
    background: transparent;
    color: var(--gb-accent);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 1.3rem;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .gb-cart__button:hover {
    background: var(--gb-accent);
    color: var(--gb-accent-text);
  }
  .gb-cart__button--solid {
    background: var(--gb-accent);
    color: var(--gb-accent-text);
  }
  .gb-cart__button[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .gb-cart__button .loading__spinner {
    margin-left: 0.4rem;
  }

  /* ---- Send as a gift ---- */
  .gb-gift__toggle {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    cursor: pointer;
    font-size: 1.4rem;
    user-select: none;
  }
  .gb-gift__toggle input {
    width: 1.7rem;
    height: 1.7rem;
    accent-color: var(--gb-accent);
    flex-shrink: 0;
  }
  .gb-gift__fields {
    display: none;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.2rem;
  }
  .gb-gift__fields.is-open {
    display: flex;
  }
  .gb-gift__field label {
    display: block;
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 0.4rem;
  }
  .gb-gift__field input,
  .gb-gift__field textarea {
    width: 100%;
    padding: 1rem 1.2rem;
    border: 1px solid rgba(var(--color-foreground), 0.2);
    border-radius: 0.6rem;
    font: inherit;
    background-color: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
  }
  .gb-gift__field textarea {
    resize: vertical;
    min-height: 8rem;
  }
  .gb-gift__error {
    color: var(--gb-accent);
    font-size: 1.2rem;
    margin-top: 0.4rem;
    display: none;
  }
  .gb-gift__error.is-visible {
    display: block;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} isolate gradient">
  <div class="section-{{ section.id }}-padding page-width">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="gift-bundle__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="gift-bundle__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="gift-bundle__heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="gift-bundle-grid">
      {% content_for 'blocks' %}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Gift Bundle Blocks",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Choose the perfect gift"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Find the right gift for her"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#b23a48"
    },
    {
      "type": "color",
      "id": "accent_text_color",
      "label": "Accent text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Card background",
      "default": "#fdf3f2"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border",
      "default": "#f0dcda"
    },
    {
      "type": "color",
      "id": "check_color",
      "label": "Checkmark color",
      "default": "#cc858f"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Muted text",
      "default": "#8a7a78"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 52
    }
  ],
  "blocks": [
    { "type": "_text" },
    { "type": "gift_bundle_product" }
  ],
  "presets": [
    {
      "name": "Gift Bundle Blocks"
    }
  ]
}
{% endschema %}
