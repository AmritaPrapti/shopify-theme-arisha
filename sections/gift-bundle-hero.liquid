{{ 'component-image-with-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .image-with-text__icons {
    display: flex;
    
    gap: 2rem;
    margin-top: 2.5rem;
  }

  .image-with-text__icon-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1.5rem;
  }

  .image-with-text__icon-media {
    flex-shrink: 0;
  }

  .image-with-text__icon-media img {
    display: block;
    width: 100%;
    height: auto;
  }

  .image-with-text__icon-text {
    font-size: 1.4rem;
  }

  .button--with-icon {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .button--icon-right {
    flex-direction: row-reverse;
  }

  .button__icon {
    display: inline-flex;
    flex-shrink: 0;
  }

  .button__icon img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media screen and (max-width: 749px) {
    .image-with-text__icons {
      gap: 1rem;
      flex-wrap: wrap;
    }
  }
{%- endstyle -%}

{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
  if section.settings.color_scheme == section.settings.section_color_scheme and section.settings.content_layout == 'no-overlap'
    assign remove_color_classes = true
  endif
-%}

{% if section.settings.height == 'custom' %}
  <style>
    .image-with-text__media--custom {
      height: {{ section.settings.custom_media_height }}px !important;
    }

    @media screen and (max-width: 749px) {
      .image-with-text__media--custom {
        height: {{ section.settings.custom_media_height_mobile }}px !important;
      }
    }
  </style>
{% endif %}

{% if section.settings.height_mobile == 'custom' %}
  <style>
    @media screen and (max-width: 749px) {
      .image-with-text__media--custom-mobile {
        height: {{ section.settings.custom_media_height_mobile }}px !important;
      }
    }
  </style>
{% endif %}

<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.section_color_scheme }}">
  <div class="{% if section.settings.enable_full_width == true %}full-width{% else %}page-width{% endif %}">
    <div class="image-with-text image-with-text--{{ section.settings.content_layout }} isolate{% if settings.text_boxes_border_thickness > 0 and settings.text_boxes_border_opacity > 0 and settings.media_border_thickness > 0 and settings.media_border_opacity > 0 %} collapse-borders{% endif %}{% unless section.settings.color_scheme == section.settings.section_color_scheme and settings.media_border_thickness > 0 and settings.text_boxes_shadow_opacity == 0 and settings.text_boxes_border_thickness == 0 or settings.text_boxes_border_opacity == 0 %} collapse-corners{% endunless %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <div class="image-with-text__grid grid grid--gapless grid--1-col grid--{% if section.settings.desktop_image_width == 'medium' %}2-col-tablet{% else %}3-col-tablet{% endif %}{% if section.settings.layout == 'text_first' %} image-with-text__grid--reverse{% endif %} {% if section.settings.mobile_layout == 'text_first' %} image-with-text__grid-mob--reverse{% endif %}">
        <div class="image-with-text__media-item image-with-text__media-item--{{ section.settings.desktop_image_width }} image-with-text__media-item--{{ section.settings.desktop_content_position }} grid__item">
          <div
            class="image-with-text__media image-with-text__media--{{ section.settings.height }} {% if section.settings.height_mobile != 'adapt' and section.settings.height_mobile != section.settings.height %}image-with-text__media--{{ section.settings.height_mobile }}-mobile{% endif %} global-media-settings{% unless remove_color_classes %} gradient color-{{ section.settings.color_scheme }}{% else %} background-transparent{% endunless %}{% if section.settings.image != blank %} media{% else %} image-with-text__media--placeholder placeholder{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}"
            {% if section.settings.height == 'adapt' and section.settings.image != blank %}
              style="padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;"
            {% endif %}
          >
            {%- if section.settings.section_url != blank -%}<a class="section_url" href="{{ section.settings.section_url }}"> &nbsp </a>{%- endif -%}
            
            {%- liquid
              assign desktop_image = section.settings.image
              assign mobile_image = section.settings.mobile-image
              assign has_mobile_image = false
              if mobile_image != blank
                assign has_mobile_image = true
              endif
            -%}
            
            {%- if desktop_image != blank -%}
              {%- if section.settings.image_behavior == 'ambient' or section.settings.image_behavior == 'zoom-in' -%}
                {%- assign widths = '198, 432, 642, 900, 1284, 1800' -%}
                {%- capture sizes -%}
              (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 1.6667 }}px,
              (min-width: 750px) calc((100vw - 130px) / 1.667), calc((100vw - 50px) / 1.667)
            {%- endcapture -%}
              {%- else -%}
                {%- assign widths = '165, 360, 535, 750, 1070, 1500' -%}
                {%- capture sizes -%}
              (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px,
              (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)
            {%- endcapture -%}
              {%- endif -%}
              
              {%- if has_mobile_image -%}
                {%- comment -%} Desktop image - hidden on mobile {%- endcomment -%}
                {{
                  desktop_image
                  | image_url: width: 1500
                  | image_tag: sizes: sizes, widths: widths, fetchpriority: fetch_priority, class: 'hide-mobile'
                }}
                
                {%- comment -%} Mobile image - shown only on mobile {%- endcomment -%}
                {{
                  mobile_image
                  | image_url: width: 750
                  | image_tag: sizes: '100vw', widths: '360, 535, 750', fetchpriority: fetch_priority, class: 'hide-desktop'
                }}
              {%- else -%}
                {%- comment -%} Single image for all devices {%- endcomment -%}
                {{
                  desktop_image
                  | image_url: width: 1500
                  | image_tag: sizes: sizes, widths: widths, fetchpriority: fetch_priority
                }}
              {%- endif -%}
            {%- else -%}
              {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
           
          </div>
        </div>
        <div class="image-with-text__text-item grid__item">
          
          <div
            id="ImageWithText--{{ section.id }}"
            class="image-with-text__content image-with-text__content--{{ section.settings.desktop_content_position }} image-with-text__content--desktop-{{ section.settings.desktop_content_alignment }} image-with-text__content--mobile-{{ section.settings.mobile_content_alignment }} image-with-text__content--{{ section.settings.height }} content-container{% unless remove_color_classes %} gradient color-{{ section.settings.color_scheme }}{% else %} background-transparent{% endunless %}"
          >
            {%- if section.settings.section_url != blank and section.settings.enable_text_link -%}<a class="section_url" href="{{ section.settings.section_url }}"> &nbsp </a>{%- endif -%}
            {%- for block in section.blocks -%}
              {% case block.type %}
                  {%- when '@app' -%}
                  {% render block %}
                {%- when 'heading' -%}
                  {%- if block.settings.heading_size == 'custom' -%}
                    <style>
                      #ImageWithText--{{ section.id }} .heading-custom-{{ block.id }} {
                        font-size: {{ block.settings.custom_font_size_desktop }}px !important;
                      }
                      @media screen and (max-width: 749px) {
                        #ImageWithText--{{ section.id }} .heading-custom-{{ block.id }} {
                          font-size: {{ block.settings.custom_font_size_mobile }}px !important;
                        }
                      }
                    </style>
                  {%- endif -%}
                  <h2
                    class="image-with-text__heading inline-richtext {% if block.settings.heading_size == 'custom' %}heading-custom-{{ block.id }}{% else %}{{ block.settings.heading_size }}{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.heading }}
                  </h2>
                {%- when 'caption' -%}
                  {%- if block.settings.text_size == 'custom' -%}
                    <style>
                      #ImageWithText--{{ section.id }} .caption-custom-{{ block.id }} {
                        font-size: {{ block.settings.custom_font_size_desktop }}px !important;
                      }
                      @media screen and (max-width: 749px) {
                        #ImageWithText--{{ section.id }} .caption-custom-{{ block.id }} {
                          font-size: {{ block.settings.custom_font_size_mobile }}px !important;
                        }
                      }
                    </style>
                  {%- endif -%}
                  <p
                    class="image-with-text__text image-with-text__text--caption {% if block.settings.text_size == 'custom' %}caption-custom-{{ block.id }}{% else %}{{ block.settings.text_style }}--{{ block.settings.text_size }}{% endif %} {{ block.settings.text_style }}"
                    {{ block.shopify_attributes }}
                    style="color: {{ block.settings.caption_color }}; --caption-highlight: {{ block.settings.caption_highlight }}; font-weight: {{ block.settings.font_weight }};"
                  >
                   <a href="{{ block.settings.link }}">{{ block.settings.caption }}</a>
                  </p>
                {%- when 'text' -%}
                  {%- if block.settings.text_size == 'custom' or block.settings.text_highlight != blank -%}
                    <style>
                      {%- if block.settings.text_size == 'custom' -%}
                        #ImageWithText--{{ section.id }} .text-custom-{{ block.id }} {
                          font-size: {{ block.settings.custom_font_size_desktop }}px !important;
                        }
                        @media screen and (max-width: 749px) {
                          #ImageWithText--{{ section.id }} .text-custom-{{ block.id }} {
                            font-size: {{ block.settings.custom_font_size_mobile }}px !important;
                          }
                        }
                      {%- endif -%}
                      {%- if block.settings.text_highlight != blank -%}
                        #ImageWithText--{{ section.id }} .text-block-{{ block.id }} span {
                          color: {{ block.settings.text_highlight }};
                        }
                      {%- endif -%}
                    </style>
                  {%- endif -%}
                  <div
                    class="image-with-text__text rte {{ block.settings.text_style }} text-block-{{ block.id }}{% if block.settings.text_size == 'custom' %} text-custom-{{ block.id }}{% endif %}"
                    {% if block.settings.text_color != blank %}style="color: {{ block.settings.text_color }};"{% endif %}
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.text }}
                  </div>
                {%- when 'icon_with_text' -%}
                  {%- if block.settings.text_size == 'custom' or block.settings.text_highlight != blank -%}
                    <style>
                      {%- if block.settings.text_size == 'custom' -%}
                        #ImageWithText--{{ section.id }} .icons-{{ block.id }} .image-with-text__icon-text {
                          font-size: {{ block.settings.custom_font_size_desktop }}px !important;
                        }
                        @media screen and (max-width: 749px) {
                          #ImageWithText--{{ section.id }} .icons-{{ block.id }} .image-with-text__icon-text {
                            font-size: {{ block.settings.custom_font_size_mobile }}px !important;
                          }
                        }
                      {%- endif -%}
                      {%- if block.settings.text_highlight != blank -%}
                        #ImageWithText--{{ section.id }} .icons-{{ block.id }} .image-with-text__icon-text span {
                          color: {{ block.settings.text_highlight }};
                        }
                      {%- endif -%}
                    </style>
                  {%- endif -%}
                  <div
                    class="image-with-text__icons icons-{{ block.id }}"
                    style="justify-content: {{ block.settings.icon_alignment }}; padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;{% if block.settings.background_color != blank %} background-color: {{ block.settings.background_color }};{% endif %}{% if block.settings.text_color != blank %} color: {{ block.settings.text_color }};{% endif %}"
                    {{ block.shopify_attributes }}
                  >
                    {%- for i in (1..3) -%}
                      {%- assign icon_key = 'icon_' | append: i -%}
                      {%- assign text_key = 'icon_text_' | append: i -%}
                      {%- assign icon_img = block.settings[icon_key] -%}
                      {%- assign icon_text = block.settings[text_key] -%}
                      {%- if icon_img != blank or icon_text != blank -%}
                        <div class="image-with-text__icon-item">
                          {%- if icon_img != blank -%}
                            <div class="image-with-text__icon-media" style="width: {{ block.settings.icon_size }}px;">
                              {{
                                icon_img
                                | image_url: width: 200
                                | image_tag: widths: '60, 100, 200', loading: 'lazy', alt: icon_text
                              }}
                            </div>
                          {%- endif -%}
                          {%- if icon_text != blank -%}
                            <div class="image-with-text__icon-text">{{ icon_text }}</div>
                          {%- endif -%}
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- when 'button' -%}
                  <div class="banner-button-wrap">
                    {%- if block.settings.button_label != blank -%}
                    <a
                      {% if block.settings.button_link == blank %}
                        role="link" aria-disabled="true"
                      {% else %}
                        href="{{ block.settings.button_link }}"
                      {% endif %}
                      class="button button--with-icon button--icon-{{ block.settings.button_icon_position }}{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                      {{ block.shopify_attributes }}
                    >
                      {%- if block.settings.button_icon != blank -%}
                        <span class="button__icon" style="width: {{ block.settings.button_icon_size }}px;">
                          {{ block.settings.button_icon | image_url: width: 120 | image_tag: widths: '30, 60, 120', loading: 'lazy', alt: block.settings.button_label }}
                        </span>
                      {%- endif -%}
                      <span class="button__label">{{ block.settings.button_label | escape }}</span>
                    </a>
                  {%- endif -%}
                    {%- if block.settings.button_label2 != blank -%}
                    <a
                      {% if block.settings.button_link2 == blank %}
                        role="link" aria-disabled="true"
                      {% else %}
                        href="{{ block.settings.button_link2 }}"
                      {% endif %}
                      class="button button--with-icon button--icon-{{ block.settings.button_icon_position2 }}{% if block.settings.button_style_secondary2 %} button--secondary{% else %} button--primary{% endif %}"
                      {{ block.shopify_attributes }}
                    >
                      {%- if block.settings.button_icon2 != blank -%}
                        <span class="button__icon" style="width: {{ block.settings.button_icon_size2 }}px;">
                          {{ block.settings.button_icon2 | image_url: width: 120 | image_tag: widths: '30, 60, 120', loading: 'lazy', alt: block.settings.button_label2 }}
                        </span>
                      {%- endif -%}
                      <span class="button__label">{{ block.settings.button_label2 | escape }}</span>
                    </a>
                  {%- endif -%}
                  </div>
                  
              {%- endcase -%}
            {%- endfor -%}
          </div>
          
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Gift Image with Text",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "url",
      "id": "section_url",
      "label": "Image Link URL",
      "info": "Make the image clickable by adding a link URL"
    },
    {
      "type": "checkbox",
      "id": "enable_text_link",
      "label": "Enable text content link",
      "info": "Make the text content area also clickable (requires Image Link URL)",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.image-with-text.settings.image.label"
    },
    {
      "type": "image_picker",
      "id": "mobile-image",
      "label": "Image for Mobile (optional)",
      "info": "Upload a separate image optimized for mobile devices. If left blank, the desktop image will be used on mobile as well."
    },
    {
      "type": "select",
      "id": "height",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.image-with-text.settings.height.options__1.label"
        },
        {
          "value": "small",
          "label": "t:sections.image-with-text.settings.height.options__2.label"
        },
        {
          "value": "medium",
          "label": "t:sections.image-with-text.settings.height.options__3.label"
        },
        {
          "value": "large",
          "label": "t:sections.image-with-text.settings.height.options__4.label"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "adapt",
      "label": "t:sections.image-with-text.settings.height.label"
    },
    {
      "type": "select",
      "id": "height_mobile",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.image-with-text.settings.height.options__1.label"
        },
        {
          "value": "small",
          "label": "t:sections.image-with-text.settings.height.options__2.label"
        },
        {
          "value": "medium",
          "label": "t:sections.image-with-text.settings.height.options__3.label"
        },
        {
          "value": "large",
          "label": "t:sections.image-with-text.settings.height.options__4.label"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "medium",
      "label": "Height for Mobile (optional)",
      "info": "Choose a different height for mobile devices. If 'Custom' is selected, you can set a specific height in pixels. If left as 'Adapt', the height will adjust based on the image's aspect ratio."
    },
     {
      "type": "range",
      "id": "custom_media_height",
      "min": 300,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "label": "Custom Media height (Desktop)",
      "default": 700,
      "visible_if": "{{ section.settings.height == 'custom' }}"
    },
     {
      "type": "range",
      "id": "custom_media_height_mobile",
      "min": 300,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "label": "Custom Media height (Mobile)",
      "default": 700,
      "visible_if": "{{ section.settings.height_mobile == 'custom' }}"
    },
    {
      "type": "select",
      "id": "desktop_image_width",
      "options": [
        {
          "value": "small",
          "label": "t:sections.image-with-text.settings.desktop_image_width.options__1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.image-with-text.settings.desktop_image_width.options__2.label"
        },
        {
          "value": "large",
          "label": "t:sections.image-with-text.settings.desktop_image_width.options__3.label"
        }
      ],
      "default": "medium",
      "label": "t:sections.image-with-text.settings.desktop_image_width.label"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "image_first",
          "label": "t:sections.image-with-text.settings.layout.options__1.label"
        },
        {
          "value": "text_first",
          "label": "t:sections.image-with-text.settings.layout.options__2.label"
        }
      ],
      "default": "image_first",
      "label": "t:sections.image-with-text.settings.layout.label"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "options": [
        {
          "value": "image_first",
          "label": "t:sections.image-with-text.settings.layout.options__1.label"
        },
        {
          "value": "text_first",
          "label": "t:sections.image-with-text.settings.layout.options__2.label"
        }
      ],
      "default": "image_first",
      "label": "Mobile Placement"
    },
    {
      "type": "select",
      "id": "image_behavior",
      "options": [
        {
          "value": "none",
          "label": "t:sections.all.animation.image_behavior.options__1.label"
        },
        {
          "value": "ambient",
          "label": "t:sections.all.animation.image_behavior.options__2.label"
        },
        {
          "value": "zoom-in",
          "label": "t:sections.all.animation.image_behavior.options__4.label"
        }
      ],
      "default": "none",
      "label": "t:sections.all.animation.image_behavior.label"
    },
    {
      "type": "header",
      "content": "t:sections.image-with-text.settings.header.content"
    }, 
    {
      "type": "checkbox",
      "id": "enable_full_width",
      "label": "Enable full width content",
      "default": false,
      "info": "When enabled, the content will stretch to the edges of the screen and the image will be contained within the page width."
    },
    {
      "type": "select",
      "id": "content_layout",
      "options": [
        {
          "value": "no-overlap",
          "label": "t:sections.image-with-text.settings.content_layout.options__1.label"
        },
        {
          "value": "overlap",
          "label": "t:sections.image-with-text.settings.content_layout.options__2.label"
        }
      ],
      "default": "no-overlap",
      "label": "t:sections.image-with-text.settings.content_layout.label"
    },       
    {
      "type": "select",
      "id": "desktop_content_position",
      "options": [
        {
          "value": "top",
          "label": "t:sections.image-with-text.settings.desktop_content_position.options__1.label"
        },
        {
          "value": "middle",
          "label": "t:sections.image-with-text.settings.desktop_content_position.options__2.label"
        },
        {
          "value": "bottom",
          "label": "t:sections.image-with-text.settings.desktop_content_position.options__3.label"
        }
      ],
      "default": "top",
      "label": "t:sections.image-with-text.settings.desktop_content_position.label"
    },
    {
      "type": "select",
      "id": "desktop_content_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.image-with-text.settings.desktop_content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.image-with-text.settings.desktop_content_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.image-with-text.settings.desktop_content_alignment.options__3.label"
        }
      ],
      "default": "left",
      "label": "t:sections.image-with-text.settings.desktop_content_alignment.label"
    },
    {
      "type": "select",
      "id": "mobile_content_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.image-with-text.settings.mobile_content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.image-with-text.settings.mobile_content_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.image-with-text.settings.mobile_content_alignment.options__3.label"
        }
      ],
      "default": "left",
      "label": "t:sections.image-with-text.settings.mobile_content_alignment.label"
    },
    {
      "type": "header",
      "content": "t:sections.image-with-text.settings.header_colors.content"
    },        
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.multirow.settings.container_color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
