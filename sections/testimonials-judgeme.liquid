{% comment %}
  Testimonials (Judge.me)
  -----------------------
  An aside that carries the pitch and the shop's average rating, beside a
  carousel of individual reviews.

  Where the reviews come from
  ---------------------------
  Liquid cannot call an API, so real Judge.me data has to arrive one of two
  ways: through Judge.me's own app blocks, or through a request from the
  browser. Judge.me's `/api/v1/reviews` list endpoint is private-token only, so
  it cannot be used here — the token would be readable in the page source. Its
  *widget* endpoint, `/api/v1/widgets/all_reviews_page.json`, does accept the
  shop's public token and does send CORS headers, so the storefront can call it
  directly. It replies with the widget's own markup, and every field we want is
  on a data attribute or a `jdgm-rev__*` class. testimonials-judgeme.js parses
  that and re-renders the reviews through snippets/testimonial-card.liquid, so
  the section keeps this theme's design rather than Judge.me's.

  The public token is in Judge.me under Settings > Integrations > Judge.me API.
  It is a read-only, browser-safe token; Judge.me publishes it for exactly this
  use. Leave the shop domain blank to use this store's own .myshopify.com domain.

  Blocks
  ------
    testimonial - a review written by hand. Used on its own, or as the fallback
                  if Judge.me cannot be reached.
    @app        - any app block, so a Judge.me average-rating badge (or any
                  other app's block) can sit in the aside or below the section.
{% endcomment %}

{{ 'testimonials-judgeme.css' | asset_url | stylesheet_tag }}
<script src="{{ 'testimonials-judgeme.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign s = section.settings

  assign jm_domain = s.judgeme_shop_domain | strip | default: shop.permanent_domain
  assign jm_token = s.judgeme_api_token | strip

  assign manual_blocks = section.blocks | where: 'type', 'testimonial'
  assign app_blocks = section.blocks | where: 'type', '@app'

  # No token means no reviews to fetch, whatever the source says.
  assign source = s.review_source
  if source != 'manual' and jm_token == blank
    assign source = 'manual'
  endif

  assign product_handle = ''
  if s.judgeme_product != blank
    assign product_handle = s.judgeme_product.handle
  endif

  # Fade cross-fades one card at a time, so it ignores the per-view settings.
  assign per_view = s.per_view
  assign per_view_mobile = s.per_view_mobile
  if s.transition == 'fade'
    assign per_view = 1
    assign per_view_mobile = 1
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ s.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ s.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ s.padding_top }}px;
      padding-bottom: {{ s.padding_bottom }}px;
    }
  }

  /* Every tunable is a custom property, so the stylesheet stays static and
     cacheable while each section instance styles itself. Colours are guarded:
     a cleared colour setting must fall through to the stylesheet default, and
     an empty `var()` value would not. */
  #shopify-section-{{ section.id }} .jm-testimonials {
    --jm-aside-width: {{ s.aside_width }}%;
    --jm-column-gap: {{ s.column_gap }}px;
    --jm-row-gap: {{ s.row_gap }}px;
    --jm-align-items: {{ s.vertical_alignment }};
    --jm-aside-alignment: {{ s.aside_alignment }};
    --jm-aside-items: {% if s.aside_alignment == 'center' %}center{% elsif s.aside_alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
    --jm-aside-alignment-mobile: {{ s.aside_alignment_mobile }};
    --jm-aside-items-mobile: {% if s.aside_alignment_mobile == 'center' %}center{% elsif s.aside_alignment_mobile == 'right' %}flex-end{% else %}flex-start{% endif %};

    --jm-eyebrow-size: {{ s.eyebrow_size }}rem;
    --jm-rating-text-size: {{ s.rating_text_size }}rem;
    --jm-rating-text-line-height: {{ s.rating_text_line_height }};
    --jm-link-size: {{ s.link_size }}rem;
    --jm-star-size: {{ s.star_size }}rem;
    {% if s.eyebrow_color != blank %}--jm-eyebrow-color: {{ s.eyebrow_color }};{% endif %}
    {% if s.heading_color != blank %}--jm-heading-color: {{ s.heading_color }};{% endif %}
    {% if s.link_color != blank %}--jm-link-color: {{ s.link_color }};{% endif %}
    {% if s.star_color != blank %}--jm-star-color: {{ s.star_color }};{% endif %}

    --jm-per-view: {{ per_view }};
    --jm-per-view-mobile: {{ per_view_mobile }};
    --jm-slide-gap: {{ s.slide_gap }}px;
    --jm-fade-duration: {{ s.fade_duration }}ms;

    --jm-card-radius: {{ s.card_radius }}px;
    --jm-card-padding: {{ s.card_padding }}px;
    --jm-card-min-height: {{ s.card_min_height }}px;
    --jm-card-min-height-mobile: {{ s.card_min_height_mobile }}px;
    --jm-card-alignment: {{ s.card_alignment }};
    --jm-card-border-width: {{ s.card_border_width }}px;
    {% if s.card_background != blank %}--jm-card-background: {{ s.card_background }};{% endif %}
    {% if s.card_text_color != blank %}--jm-card-color: {{ s.card_text_color }};{% endif %}
    {% if s.card_border_color != blank %}--jm-card-border-color: {{ s.card_border_color }};{% endif %}
    {% if s.card_shadow %}--jm-card-shadow: 0 {{ s.card_shadow_offset }}px {{ s.card_shadow_blur }}px rgba(var(--color-shadow), {{ s.card_shadow_opacity | divided_by: 100.0 }});{% endif %}

    --jm-quote-size: {{ s.quote_mark_size }}rem;
    {% if s.quote_mark_color != blank %}--jm-quote-color: {{ s.quote_mark_color }};{% endif %}

    --jm-review-size: {{ s.review_text_size }}rem;
    --jm-review-style: {% if s.review_italic %}italic{% else %}normal{% endif %};
    --jm-review-line-height: {{ s.review_line_height }};
    --jm-review-clamp: {{ s.review_clamp_lines }};
    --jm-review-title-size: {{ s.review_title_size }}rem;
    --jm-author-size: {{ s.author_size }}rem;
    --jm-author-meta-size: {{ s.author_meta_size }}rem;
    {% if s.verified_color != blank %}--jm-verified-color: {{ s.verified_color }};{% endif %}

    --jm-button-size: {{ s.arrow_size }}px;
    --jm-counter-size: {{ s.counter_size }}rem;
    {% if s.arrow_color != blank %}--jm-button-color: {{ s.arrow_color }};{% endif %}
    {% if s.arrow_border_color != blank %}--jm-button-border: {{ s.arrow_border_color }};{% endif %}
    {% if s.arrow_background != blank %}--jm-button-background: {{ s.arrow_background }};{% endif %}
    {% if s.counter_color != blank %}--jm-counter-color: {{ s.counter_color }}; --jm-dot-active-color: {{ s.counter_color }};{% endif %}
    --jm-controls-justify: {% if s.controls_alignment == 'center' %}center{% elsif s.controls_alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
  }
{%- endstyle -%}

{%- capture controls -%}
  <div
    class="jm-slider__controls{% if s.arrows_position == 'card' %} jm-slider__controls--overlay{% else %} jm-slider__controls--below{% endif %}"
    data-jm-controls
  >
    {%- if s.show_arrows -%}
      <button
        type="button"
        class="jm-slider__button jm-slider__button--prev"
        aria-label="{{ s.previous_label | escape }}"
        data-jm-prev
      >
        <svg viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
          <path d="M4.5 1.5L10 7l-5.5 5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    {%- endif -%}

    {%- if s.pagination_style == 'counter' -%}
      <span class="jm-slider__counter" aria-live="polite" data-jm-counter></span>
    {%- elsif s.pagination_style == 'dots' -%}
      <div class="jm-slider__dots" role="tablist" aria-label="{{ s.pagination_label | escape }}" data-jm-dots></div>
    {%- endif -%}

    {%- if s.show_arrows -%}
      <button
        type="button"
        class="jm-slider__button jm-slider__button--next"
        aria-label="{{ s.next_label | escape }}"
        data-jm-next
      >
        <svg viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
          <path d="M4.5 1.5L10 7l-5.5 5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    {%- endif -%}
  </div>
{%- endcapture -%}

{%- capture app_block_markup -%}
  {%- for block in app_blocks -%}
    <div class="jm-testimonials__app-block" {{ block.shopify_attributes }}>
      {%- render block -%}
    </div>
  {%- endfor -%}
{%- endcapture -%}

<div
  class="jm-testimonials-section color-{{ s.color_scheme }} gradient"
  {% if s.anchor_id != blank %}id="{{ s.anchor_id | escape }}"{% endif %}
>
  <div class="{% if s.full_width == false %}page-width{% else %}jm-testimonials-section__wide{% endif %} section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <judgeme-testimonials
      class="jm-testimonials{% if s.layout != 'stacked' %} jm-testimonials--split{% endif %}{% if s.layout == 'text_right' %} jm-testimonials--reverse{% endif %}"
      aria-roledescription="carousel"
      {% if s.eyebrow != blank %}aria-label="{{ s.eyebrow | strip_html | escape }}"{% endif %}
    >
      <script type="application/json" data-jm-config>
        {
          "source": {{ source | json }},
          "shopDomain": {{ jm_domain | json }},
          "apiToken": {{ jm_token | json }},
          "maxReviews": {{ s.max_reviews | json }},
          "minRating": {{ s.min_rating | json }},
          "verifiedOnly": {{ s.verified_only | json }},
          "minChars": {{ s.min_chars | json }},
          "maxChars": {{ s.max_chars | json }},
          "productHandle": {{ product_handle | json }},
          "sort": {{ s.review_sort | json }},
          "cacheMinutes": {{ s.cache_minutes | json }},
          "syncSummary": {{ s.sync_summary | json }},
          "showCardStars": {{ s.show_card_stars | json }},
          "showTitle": {{ s.show_card_title | json }},
          "showVerified": {{ s.show_verified | json }},
          "showDate": {{ s.show_date | json }},
          "showProduct": {{ s.show_product | json }},
          "transition": {{ s.transition | json }},
          "autoplay": {{ s.autoplay | json }},
          "autoplaySpeed": {{ s.autoplay_speed | json }},
          "loop": {{ s.loop | json }},
          "counterFormat": {{ s.counter_format | json }},
          "anonymousLabel": {{ s.anonymous_label | json }},
          "outOfFiveLabel": "out of 5 stars",
          "slideLabel": {{ s.slide_label | json }},
          "goToLabel": {{ s.pagination_label | json }},
          "locale": {{ request.locale.iso_code | json }}
        }
      </script>

      {%- comment -%} ------------------------------------------- aside {%- endcomment -%}
      <div class="jm-testimonials__aside">
        {%- if s.eyebrow != blank -%}
          <p class="jm-testimonials__eyebrow">{{ s.eyebrow }}</p>
        {%- endif -%}

        {%- if s.heading != blank -%}
          <h2 class="jm-testimonials__heading inline-richtext {{ s.heading_size }}">
            {{ s.heading }}
          </h2>
        {%- endif -%}

        {%- if s.show_summary -%}
          <div class="jm-testimonials__rating">
            {%- if s.show_summary_stars -%}
              <span
                class="jm-testimonials__stars"
                style="--jm-star-rating: {{ s.rating_value }};"
                role="img"
                aria-label="{{ s.rating_value }} out of 5 stars"
                data-jm-summary-stars
              ></span>
            {%- endif -%}

            {%- if s.rating_text != blank -%}
              {%- liquid
                assign average_markup = '<span data-jm-summary-average>' | append: s.rating_value | append: '</span>'
                assign count_markup = '<span data-jm-summary-count>' | append: s.rating_count | append: '</span>'
                assign rating_text = s.rating_text | escape | replace: '[average]', average_markup | replace: '[count]', count_markup | newline_to_br
              -%}
              <p class="jm-testimonials__rating-text">{{ rating_text }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if s.aside_text != blank -%}
          <div class="jm-testimonials__aside-text rte">{{ s.aside_text }}</div>
        {%- endif -%}

        {%- comment -%}
          Both halves are required: a label with nowhere to go would render a
          link that does nothing, so a blank URL hides it entirely.
        {%- endcomment -%}
        {%- if s.link_label != blank and s.link_url != blank -%}
          {%- comment -%}
            Label and arrow are one text run, deliberately. The gap is a
            non-breaking space because text-decoration paints across a space
            but not across padding, a margin or a flex gap — and nbsp also
            stops the arrow being orphaned on its own line. Wrapping the arrow
            in a span would open a second inline box, and the browser then
            paints the rule in two segments with a visible seam between them.
            aria-label keeps the arrow out of the link's accessible name
            without needing that wrapper.
          {%- endcomment -%}
          <a
            class="jm-testimonials__link"
            href="{{ s.link_url }}"
            aria-label="{{ s.link_label | escape }}"
          >
            {{- s.link_label -}}&nbsp;&rarr;
          </a>
        {%- endif -%}

        {%- if app_blocks.size > 0 and s.app_blocks_position == 'aside' -%}
          <div class="jm-testimonials__app-blocks">{{ app_block_markup }}</div>
        {%- endif -%}
      </div>

      {%- comment -%} ------------------------------------------ reviews {%- endcomment -%}
      <div class="jm-testimonials__main">
        <div
          class="jm-slider{% if s.transition == 'fade' %} jm-slider--fade{% endif %}{% if s.arrows_position == 'card' %} jm-slider--controls-card{% endif %}"
          data-jm-slider
        >
          <div class="jm-slider__track" data-jm-track>
            {%- if manual_blocks.size > 0 -%}
              {%- for block in manual_blocks -%}
                {%- render 'testimonial-card',
                  block: block,
                  rating: block.settings.rating,
                  title: block.settings.title,
                  body: block.settings.body,
                  author: block.settings.author,
                  location: block.settings.location,
                  date: block.settings.date,
                  product_title: block.settings.product.title,
                  product_url: block.settings.product.url,
                  verified: block.settings.verified
                -%}
              {%- endfor -%}
            {%- endif -%}

            {%- comment -%}
              Nothing written by hand and reviews still to fetch: hold the space
              with skeletons so the rest of the page does not jump when they
              land. JS removes them either way.
            {%- endcomment -%}
            {%- if manual_blocks.size == 0 and source != 'manual' -%}
              {%- assign skeleton_count = per_view | at_least: 1 -%}
              {%- for i in (1..skeleton_count) -%}
                <div class="jm-slider__slide" data-jm-skeleton data-jm-status>
                  <div class="jm-review jm-review--skeleton" aria-hidden="true">
                    <span class="jm-skeleton-line"></span>
                    <span class="jm-skeleton-line"></span>
                    <span class="jm-skeleton-line"></span>
                    <span class="jm-skeleton-line"></span>
                  </div>
                </div>
              {%- endfor -%}
            {%- endif -%}
          </div>

          {%- if s.arrows_position == 'card' -%}
            {{ controls }}
          {%- endif -%}
        </div>

        {%- if s.arrows_position == 'below' -%}
          {{ controls }}
        {%- endif -%}
      </div>

      {%- comment -%}
        The blueprint the JS clones for each fetched review. Rendered through the
        same snippet as the hand-written cards so the two cannot drift apart.
      {%- endcomment -%}
      {%- if source != 'manual' -%}
        <template data-jm-slide-template>
          {%- render 'testimonial-card', mode: 'template' -%}
        </template>
      {%- endif -%}
    </judgeme-testimonials>

    {%- if app_blocks.size > 0 and s.app_blocks_position == 'below' -%}
      <div class="jm-testimonials__app-blocks jm-testimonials__app-blocks--below">
        {{ app_block_markup }}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Testimonials (Judge.me)",
  "tag": "section",
  "class": "section",
  "max_blocks": 24,
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Link to this section from a button with #your-id (letters, numbers and hyphens)."
    },

    { "type": "header", "content": "Reviews" },
    {
      "type": "select",
      "id": "review_source",
      "label": "Where reviews come from",
      "options": [
        { "value": "judgeme", "label": "Judge.me (live)" },
        { "value": "both", "label": "Written by hand, then Judge.me" },
        { "value": "manual", "label": "Written by hand only" }
      ],
      "default": "judgeme",
      "info": "Live reviews are fetched in the browser from Judge.me's public widget API. If Judge.me cannot be reached, any Testimonial blocks you have added are shown instead."
    },
    {
      "type": "text",
      "id": "judgeme_api_token",
      "label": "Judge.me public API token",
      "info": "Judge.me admin > Settings > Integrations > Judge.me API. Use the PUBLIC token — it is read-only and safe in a storefront. Never paste the private token here.",
      "visible_if": "{{ section.settings.review_source != 'manual' }}"
    },
    {
      "type": "text",
      "id": "judgeme_shop_domain",
      "label": "Shop domain",
      "info": "Leave blank to use this store's .myshopify.com domain. Only set this to pull reviews from a different store.",
      "visible_if": "{{ section.settings.review_source != 'manual' }}"
    },
    {
      "type": "range",
      "id": "max_reviews",
      "label": "Number of reviews",
      "min": 1,
      "max": 24,
      "step": 1,
      "default": 6,
      "visible_if": "{{ section.settings.review_source != 'manual' }}"
    },
    {
      "type": "select",
      "id": "review_sort",
      "label": "Order",
      "options": [
        { "value": "recent", "label": "Most recent" },
        { "value": "rating", "label": "Highest rated" },
        { "value": "longest", "label": "Longest first" },
        { "value": "shortest", "label": "Shortest first" },
        { "value": "random", "label": "Random" }
      ],
      "default": "recent",
      "visible_if": "{{ section.settings.review_source != 'manual' }}"
    },
    {
      "type": "range",
      "id": "min_rating",
      "label": "Minimum star rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.review_source != 'manual' }}"
    },
    {
      "type": "checkbox",
      "id": "verified_only",
      "label": "Verified buyers only",
      "default": false,
      "visible_if": "{{ section.settings.review_source != 'manual' }}"
    },
    {
      "type": "range",
      "id": "min_chars",
      "label": "Skip reviews shorter than",
      "min": 0,
      "max": 300,
      "step": 10,
      "unit": "ch",
      "default": 40,
      "info": "Keeps one-word reviews out of a section built around a long quote.",
      "visible_if": "{{ section.settings.review_source != 'manual' }}"
    },
    {
      "type": "range",
      "id": "max_chars",
      "label": "Skip reviews longer than",
      "min": 0,
      "max": 1000,
      "step": 50,
      "unit": "ch",
      "default": 400,
      "info": "0 for no limit.",
      "visible_if": "{{ section.settings.review_source != 'manual' }}"
    },
    {
      "type": "product",
      "id": "judgeme_product",
      "label": "Only reviews of this product",
      "info": "Leave empty for reviews of every product. Ignored when reviews are written by hand."
    },
    {
      "type": "range",
      "id": "cache_minutes",
      "label": "Cache reviews for",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "min",
      "default": 30,
      "info": "Reviews are remembered for the rest of the visitor's session, so Judge.me is called once rather than on every page. 0 to always refetch.",
      "visible_if": "{{ section.settings.review_source != 'manual' }}"
    },

    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "text_left", "label": "Text left, reviews right" },
        { "value": "text_right", "label": "Reviews left, text right" },
        { "value": "stacked", "label": "Text above reviews" }
      ],
      "default": "text_left"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "range",
      "id": "aside_width",
      "label": "Text column width",
      "min": 20,
      "max": 55,
      "step": 1,
      "unit": "%",
      "default": 34,
      "visible_if": "{{ section.settings.layout != 'stacked' }}"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Space between columns",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.layout != 'stacked' }}"
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Space between rows",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment",
      "options": [
        { "value": "start", "label": "Top" },
        { "value": "center", "label": "Middle" },
        { "value": "stretch", "label": "Stretch" }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.layout != 'stacked' }}"
    },

    { "type": "header", "content": "Text column" },
    {
      "type": "select",
      "id": "aside_alignment",
      "label": "Alignment on desktop",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "aside_alignment_mobile",
      "label": "Alignment on mobile",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center",
      "info": "Applies once the two columns stack, below 990px."
    },
    {
      "type": "inline_richtext",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Loved by postpartum mothers"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Eyebrow size",
      "min": 1,
      "max": 2.4,
      "step": 0.1,
      "unit": "rem",
      "default": 1.2
    },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow colour", "default": "#cc859a" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real stories from real moms"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" },
        { "value": "hxl", "label": "Extra large" }
      ],
      "default": "h1"
    },
