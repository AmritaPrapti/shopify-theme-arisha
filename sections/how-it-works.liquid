{{ 'how-it-works.css' | asset_url | stylesheet_tag }}
{% assign number_font = section.settings.number_font %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  {{  number_font | font_face: font_display: 'swap' }}

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
   .loop_counter {
    --counter-font: {{ number_font.family }}, {{ number_font.fallback_families }};

   }

  {%- if section.settings.layout == 'steps' -%}
    /* Horizontal steps: numbered circles in a row with arrows between them */
    #shopify-section-{{ section.id }} .how-it-works__steps {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.6rem;
      margin-top: 3.2rem;
    }
    #shopify-section-{{ section.id }} .how-it-works__step {
      flex: 1 1 0;
      min-width: 0;
      max-width: 32rem;
      text-align: center;
    }
    #shopify-section-{{ section.id }} .how-it-works__step-number {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 4.8rem;
      height: 4.8rem;
      margin-bottom: 1.2rem;
      border: 1.5px solid {{ section.settings.step_color }};
      border-radius: 50%;
      color: {{ section.settings.step_color }};
      /* body font: the heading font's old-style numerals are too small to read */
      font-family: var(--font-body-family);
      font-size: 1.8rem;
      font-weight: 500;
      font-variant-numeric: lining-nums;
      line-height: 1;
    }
    #shopify-section-{{ section.id }} .how-it-works__step-title {
      margin: 0 0 0.8rem;
      font-size: 2.4rem;
    }
    #shopify-section-{{ section.id }} .how-it-works__step-description > :first-child {
      margin-top: 0;
    }
    #shopify-section-{{ section.id }} .how-it-works__step-arrow {
      flex: none;
      width: 2.4rem;
      height: 2.4rem;
      color: {{ section.settings.step_color }};
      transform: rotate(90deg);
    }
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .how-it-works__steps {
        flex-direction: row;
        align-items: flex-start;
        justify-content: center;
        gap: 2.4rem;
      }
      #shopify-section-{{ section.id }} .how-it-works__step-arrow {
        /* line up with the middle of the number circles */
        margin-top: 1.2rem;
        transform: none;
      }
    }
  {%- endif -%}
{%- endstyle -%}

<section class="gradiant color-{{ section.settings.color_scheme }}">

    <div class="page-width section-{{ section.id }}-padding">
        <div class="how-it-works__header text-align-{{ section.settings.header_alignment }} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
            {% if section.settings.title != blank %}
                
                <h2
                    class="image-with-text__heading  inline-richtext {{ section.settings.heading_size }}"
                  >
                    {{ section.settings.title }}
                  </h2>
            {% endif %}
            {% if section.settings.subtitle != blank %}
                <p class="how-it-works__subtitle">{{ section.settings.subtitle }}</p>
            {% endif %}
        </div>
        {%- if section.settings.layout == 'steps' -%}
        <div class="how-it-works__steps">
            {%- for block in section.blocks -%}
                <div class="how-it-works__step {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" {{ block.shopify_attributes }}>
                    <span class="how-it-works__step-number">{{ forloop.index }}</span>
                    {%- if block.settings.list_title != blank -%}
                        <h3 class="how-it-works__step-title">{{ block.settings.list_title }}</h3>
                    {%- endif -%}
                    {%- if block.settings.list_description != blank -%}
                        <div class="how-it-works__step-description rte">{{ block.settings.list_description }}</div>
                    {%- endif -%}
                </div>
                {%- unless forloop.last -%}
                    <svg class="how-it-works__step-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                        <path d="M4 12h16M14 6l6 6-6 6"/>
                    </svg>
                {%- endunless -%}
            {%- endfor -%}
        </div>
        {%- else -%}
        <div class="how-it-works__inner-wrapper">
            
            <div class="how-it-works__image-wrapper how-it-works__image-wrapper--{{ section.settings.image_position }} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in-right{% endif %}">
                {% render 'image', image: section.settings.image %}
            </div>
           
            <div class="how-it-works__content">
                {% for block in section.blocks %}
                    <div class="how-it-works__block {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in-left{% endif %}">
                        <span class="loop_counter h3 loop-counter-{{ section.settings.font_size }} {% if section.settings.list_style == 'numbered' %} numbered {% endif %}">{{ forloop.index }}</span>
                        <div class="list-de">
                            {% if block.settings.list_title != blank %}
                                <h3 class="how-it-works__block-title">{{ block.settings.list_title }}</h3>
                            {% endif %}
                            {% if block.settings.list_description != blank %}
                                <div class="how-it-works__block-description rte">{{ block.settings.list_description }}</div>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
        {%- endif -%}

    </div>

</section>


{% schema %}
    {
        "name": "How it works",
        "settings": [
            {
                "type": "text",
                "id": "title",
                "label": "Title",
                "default": "How It Works"
            },
            {
                "type": "select",
                "id": "heading_size",
                "options": [
                    {
                    "value": "h2",
                    "label": "t:sections.all.heading_size.options__1.label"
                    },
                    {
                    "value": "h1",
                    "label": "t:sections.all.heading_size.options__2.label"
                    },
                    {
                    "value": "h0",
                    "label": "t:sections.all.heading_size.options__3.label"
                    },
                    {
                    "value": "hxl",
                    "label": "t:sections.all.heading_size.options__4.label"
                    },
                    {
                    "value": "hxxl",
                    "label": "t:sections.all.heading_size.options__5.label"
                    }
                ],
                "default": "h1",
                "label": "t:sections.all.heading_size.label"
            },
            {
                "type": "text",
                "id": "subtitle",
                "label": "Subtitle",
                "default": "From order to table in four simple steps"
            },
            {
                "type": "select",
                "id": "header_alignment",
                "label": "Header Alignment",
                "options": [
                    {
                    "value": "left",
                    "label": "Left"
                    },
                    {
                    "value": "center",
                    "label": "Center"
                    },
                    {
                    "value": "right",
                    "label": "Right"
                    }
                ],
                "default": "center"
            },
            {
                "type": "select",
                "id": "layout",
                "label": "Layout",
                "options": [
                    {
                    "value": "image",
                    "label": "Vertical list with image"
                    },
                    {
                    "value": "steps",
                    "label": "Horizontal steps"
                    }
                ],
                "default": "image",
                "info": "Horizontal steps shows numbered circles in a row with arrows, without the image."
            },
            {
                "type": "color",
                "id": "step_color",
                "label": "Step accent color",
                "default": "#b07a72",
                "visible_if": "{{ section.settings.layout == 'steps' }}"
            },
            {
                "type": "image_picker",
                "id": "image",
                "label": "Image",
                "visible_if": "{{ section.settings.layout != 'steps' }}"
            },
            {
                "type": "select",
                "id": "image_position",
                "label": "Image Position",
                "options": [
                    {
                    "value": "first",
                    "label": "First"
                    },
                    {
                    "value": "second",
                    "label": "Second"
                    }
                ],
                "default": "second",
                "info": "Choose whether the image appears before or after the text content on desktop.",
                "visible_if": "{{ section.settings.layout != 'steps' }}"
            },
            {
                "type": "select",
                "id": "list_style",
                "label": "List Style",
                "options": [
                    {
                    "value": "rounded",
                    "label": "Rounded Background"
                    },
                    {
                    "value": "numbered",
                    "label": "Numbered"
                    }
                ],
                "default": "rounded",
                "info": "Choose a style for the list blocks. This will apply to all blocks within this section."
            },
            {
                "type": "font_picker",
                "id": "number_font",
                "label": "Number Font",
                "visible_if": "{{ section.settings.list_style == 'numbered' }}",
                "default": "quattrocento_sans_n4",
            },
           {
            "type": "select",
            "id": "font_size",
            "label": "Font Size for Number",
            "visible_if": "{{ section.settings.list_style == 'numbered' }}",
            "options": [
                {
                "value": "small",
                "label": "Small"
                },
                {
                "value": "medium",
                "label": "Medium"
                },
                {
                "value": "large",
                "label": "Large"
                },
                {  
                "value": "extra-large",
                "label": "Extra Large"
                }
            ],
            "default": "medium",
            "info": "Choose the font size for the numbers in the list."
           },
            {
                "type": "color_scheme",
                "id": "color_scheme",
                "label": "t:sections.multirow.settings.container_color_scheme.label",
                "default": "scheme-1"
            },
            {
                "type": "header",
                "content": "t:sections.all.padding.section_padding_heading"
            },
            {
                "type": "range",
                "id": "padding_top",
                "min": 0,
                "max": 100,
                "step": 4,
                "unit": "px",
                "label": "t:sections.all.padding.padding_top",
                "default": 36
            },
            {
                "type": "range",
                "id": "padding_bottom",
                "min": 0,
                "max": 100,
                "step": 4,
                "unit": "px",
                "label": "t:sections.all.padding.padding_bottom",
                "default": 36
            }
        ],
        "blocks": [
            {
                "type": "list",
                "name": "List",
                "settings": [
                    {
                        "type": "text",
                        "id": "list_title",
                        "label": "List Title"
                    },
                    {
                        "type": "richtext",
                        "id": "list_description",
                        "label": "List Description"
                    }
                ]
            }
        ],
        "presets": [
            {
                "name": "How it works"
            }
        ]
    }
{% endschema %}
