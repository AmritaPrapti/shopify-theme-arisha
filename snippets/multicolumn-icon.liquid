{% comment %}
  Line icon used as a fallback when a Multicolumn column has no image.
  Strokes use currentColor, so the colour comes from the wrapper.

  Accepts:
  - icon: {String} dollar | gift | chart | heart | leaf | star | people

  Usage:
  {% render 'multicolumn-icon', icon: block.settings.icon %}
{% endcomment %}
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case icon -%}
    {%- when 'dollar' -%}
      <circle cx="24" cy="24" r="20"/>
      <path d="M30 17.5c-1.2-1.6-3.4-2.5-6-2.5-3.6 0-6 1.8-6 4.5 0 6.5 12.5 3 12.5 9.5 0 2.8-2.6 4.5-6.5 4.5-2.8 0-5.2-1-6.5-2.8"/>
      <path d="M24 11v4M24 33v4"/>
    {%- when 'gift' -%}
      <rect x="7" y="17" width="34" height="8" rx="1"/>
      <path d="M10 25v16h28V25"/>
      <path d="M24 17v24"/>
      <path d="M24 17c-2-5-8-9-10.5-6.5C11 13 15.5 17 24 17z"/>
      <path d="M24 17c2-5 8-9 10.5-6.5C37 13 32.5 17 24 17z"/>
    {%- when 'chart' -%}
      <rect x="8" y="28" width="7" height="12" rx="1"/>
      <rect x="20.5" y="18" width="7" height="22" rx="1"/>
      <rect x="33" y="8" width="7" height="32" rx="1"/>
    {%- when 'heart' -%}
      <path d="M24 40S7 30 7 18.5C7 13 11 9 16 9c3.5 0 6.4 2 8 5 1.6-3 4.5-5 8-5 5 0 9 4 9 9.5C41 30 24 40 24 40z"/>
    {%- when 'leaf' -%}
      <path d="M10 38C10 20 22 9 40 8c0 19-11 30-27 30h-3z"/>
      <path d="M10 38c6-8 13-14 22-20"/>
    {%- when 'star' -%}
      <path d="M24 6l5.4 11.4 12.6 1.6-9.2 8.7 2.3 12.4L24 34l-11.1 6.1 2.3-12.4L6 19l12.6-1.6z"/>
    {%- when 'people' -%}
      <circle cx="18" cy="16" r="6"/>
      <path d="M6 39c0-7 5.4-12 12-12s12 5 12 12"/>
      <circle cx="34" cy="18" r="5"/>
      <path d="M32 27.2c5.6-.9 10 3.6 10 9.8"/>
  {%- endcase -%}
</svg>
